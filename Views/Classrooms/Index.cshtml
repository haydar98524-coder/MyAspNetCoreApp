@model List<Classroom>
@{
    ViewData["Title"] = L.T("Classrooms", "القاعات");
    var upcoming = ViewBag.Upcoming as List<ClassroomBooking> ?? new();
    var today = (DayOfWeek)ViewBag.Today;
}
<div class="page-head">
    <div>
        <h1 class="page-title">@L.T("Classrooms & halls", "القاعات والمختبرات")</h1>
        <p class="page-sub">@L.Num(Model.Count) @L.T("rooms", "قاعة") · @L.Num(Model.Count(r => r.Status == ClassroomStatus.Available)) @L.T("available", "متاحة") · @L.Num(Model.Sum(r => r.Capacity)) @L.T("total seats", "مقعداً")</p>
    </div>
    <div class="flex gap-2">
        <a asp-controller="Rentals" asp-action="Bookings" class="btn btn-outline btn-sm"><svg class="h-4 w-4"><use href="#i-calendar"/></svg>@L.T("Hall bookings", "حجوزات القاعات")</a>
        <a asp-action="Create" class="btn btn-primary btn-sm"><svg class="h-4 w-4"><use href="#i-plus"/></svg>@L.T("Add classroom", "إضافة قاعة")</a>
    </div>
</div>

<div class="grid gap-5 xl:grid-cols-3">
    <div class="xl:col-span-2">
        <div class="grid gap-4 sm:grid-cols-2">
            @foreach (var r in Model)
            {
                var todaySlots = r.Schedules.Where(s => s.DayOfWeek == today && s.Section.IsActive).OrderBy(s => s.StartTime).ToList();
                var badge = r.Status switch
                {
                    ClassroomStatus.Available => "badge-green",
                    ClassroomStatus.Maintenance => "badge-amber",
                    _ => "badge-gray"
                };
                <div class="card p-5">
                    <div class="flex items-start justify-between">
                        <div class="flex items-center gap-3">
                            <span class="stat-icon bg-brand-50 text-brand-700"><svg class="h-5 w-5"><use href="#i-building"/></svg></span>
                            <div>
                                <p class="font-extrabold text-brand-950">@L.Pick(r.NameAr, r.NameEn)</p>
                                <p class="text-[11px] text-ink-500">@r.Number · @r.Floor · @r.RoomType</p>
                            </div>
                        </div>
                        <span class="badge @badge">@L.E(r.Status)</span>
                    </div>
                    <div class="mt-3 grid grid-cols-3 gap-2 text-center text-[11px]">
                        <div class="rounded-lg bg-sand-50 py-1.5"><p class="font-bold text-brand-900">@r.Capacity</p><p class="text-ink-500">@L.T("seats", "مقعد")</p></div>
                        <div class="rounded-lg bg-sand-50 py-1.5"><p class="font-bold text-brand-900">@todaySlots.Count</p><p class="text-ink-500">@L.T("today", "اليوم")</p></div>
                        <div class="rounded-lg bg-sand-50 py-1.5"><p class="font-bold text-brand-900">@L.Money(r.RentPerHour)</p><p class="text-ink-500">@L.T("per hour", "بالساعة")</p></div>
                    </div>
                    @if (todaySlots.Count > 0)
                    {
                        <div class="mt-3 space-y-1">
                            @foreach (var s in todaySlots.Take(3))
                            {
                                <div class="flex items-center justify-between rounded-lg border border-sand-200 px-2 py-1 text-[10px]">
                                    <span class="truncate font-semibold text-ink-700">@L.Pick(s.Section.Course.NameAr, s.Section.Course.NameEn)</span>
                                    <span class="shrink-0 text-ink-500" dir="ltr">@s.StartTime</span>
                                </div>
                            }
                        </div>
                    }
                    <div class="mt-3 flex justify-end border-t border-sand-100 pt-2">
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-ghost btn-xs"><svg class="h-3.5 w-3.5"><use href="#i-edit"/></svg>@L.T("Edit", "تعديل")</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="space-y-4">
        <div class="card">
            <div class="card-header"><h2 class="section-title">@L.T("Upcoming bookings", "الحجوزات القادمة")</h2><a asp-controller="Rentals" asp-action="Bookings" class="text-xs link">@L.T("All", "الكل")</a></div>
            <div class="divide-y divide-sand-200">
                @if (upcoming.Count == 0) { <div class="empty !py-6">@L.T("No upcoming bookings.", "لا توجد حجوزات قادمة.")</div> }
                @foreach (var b in upcoming)
                {
                    <div class="px-4 py-3">
                        <div class="flex items-center justify-between gap-2">
                            <p class="truncate text-xs font-bold text-ink-900">@b.TenantName</p>
                            <span class="badge @(b.PaymentStatus == BookingPaymentStatus.Paid ? "badge-green" : "badge-amber")">@L.E(b.PaymentStatus)</span>
                        </div>
                        <p class="mt-0.5 text-[11px] text-ink-500">@L.DateShort(b.Date) · @b.StartTime–@b.EndTime · @L.Pick(b.Classroom.NameAr, b.Classroom.NameEn)</p>
                    </div>
                }
            </div>
        </div>

        <div class="card card-pad !bg-brand-50">
            <h2 class="section-title mb-2">@L.T("Utilisation rule", "قاعدة الاستخدام")</h2>
            <p class="text-xs leading-6 text-brand-800">@L.T("Course schedules take priority over paid hall rentals. The system blocks double-booking a room for the same day and overlapping time.", "جداول الدورات لها الأولوية على حجوزات القاعات المدفوعة. يمنع النظام الحجز المزدوج للقاعة في نفس اليوم والوقت المتداخل.")</p>
        </div>
    </div>
</div>

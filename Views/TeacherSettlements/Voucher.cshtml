@model TeacherSettlement
@{
    Layout = null;
    var settings = ViewBag.Settings as InstituteSettings ?? new InstituteSettings();
    var totalLines = Model.Lines.Sum(l => l.Amount);
}
<!DOCTYPE html>
<html lang="@L.Lang" dir="@L.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.SettlementNo · @L.T("Payout voucher", "سند صرف مستحقات")</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
</head>
<body class="min-h-screen bg-sand-100 py-6 print:bg-white print:py-0">
    @await Html.PartialAsync("_Icons")
    <div class="mx-auto max-w-3xl px-4">
        <div class="no-print mb-4 flex flex-wrap items-center justify-between gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline btn-sm"><svg class="h-4 w-4 flip-x"><use href="#i-arrow-left"/></svg>@L.T("Back to statement", "عودة للكشف")</a>
            <button onclick="window.print()" class="btn btn-primary btn-sm"><svg class="h-4 w-4"><use href="#i-printer"/></svg>@L.T("Print voucher", "طباعة السند")</button>
        </div>

        <article class="relative overflow-hidden rounded-2xl border border-sand-200 bg-white shadow-card print:rounded-none print:border-0 print:shadow-none">
            <div class="h-2 bg-gradient-to-r from-brand-800 via-brand-600 to-gold-500"></div>
            <div class="p-7 sm:p-10">
                <header class="flex flex-wrap items-start justify-between gap-4 border-b border-dashed border-sand-300 pb-6">
                    <div>
                        <div class="flex items-center gap-3">
                            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-950 text-gold-400">
                                <svg class="h-6 w-6"><use href="#i-book"/></svg>
                            </span>
                            <div>
                                <p class="text-base font-extrabold leading-tight text-brand-950">@L.Pick(settings.NameAr, settings.NameEn)</p>
                                <p class="text-[11px] text-ink-500">@L.T("for Tutoring · Kirkuk · Iraq", "لدورات التقوية · كركوك · العراق")</p>
                            </div>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[10px] text-ink-500">
                            <span>@L.T("License", "إجازة"): @settings.LicenseNo</span>
                            <span>@L.T("Ministry code", "رمز الوزارة"): @settings.MinistryCode</span>
                            <span dir="ltr">@settings.Phone</span>
                        </div>
                    </div>
                    <div class="text-end">
                        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-gold-600">@L.T("Payout voucher", "سند صرف مستحقات")</p>
                        <p class="mt-1 font-mono text-lg font-extrabold text-brand-950" dir="ltr">@Model.SettlementNo</p>
                        <p class="text-[11px] text-ink-500">@L.Date(Model.PaidAt ?? Model.ApprovedAt ?? DateTime.Today)</p>
                        <span class="mt-2 inline-flex badge @(Model.Status == TeacherSettlementStatus.Paid ? "badge-green" : "badge-blue")">@L.E(Model.Status)</span>
                    </div>
                </header>

                <section class="mt-6 grid gap-5 sm:grid-cols-2">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-400">@L.T("Paid to", "صُرف إلى")</p>
                        <p class="mt-1 text-sm font-bold text-brand-950">@L.Pick(Model.Teacher.FullNameAr, Model.Teacher.FullNameEn)</p>
                        <p class="text-[11px] text-ink-500">@L.T("Teacher code", "رمز المدرّس"): @Model.Teacher.Code</p>
                        <p class="text-[11px] text-ink-500">@Model.Teacher.Specialization</p>
                        <p class="mt-1 text-[11px] text-ink-500" dir="ltr">@Model.Teacher.Phone</p>
                    </div>
                    <div class="sm:text-end">
                        <p class="text-[10px] font-bold uppercase tracking-wide text-ink-400">@L.T("Statement period", "فترة الكشف")</p>
                        <p class="mt-1 text-sm font-bold text-ink-900">@L.DateShort(Model.PeriodStart) – @L.DateShort(Model.PeriodEnd)</p>
                        <p class="text-[11px] text-ink-500">@L.T("Contract", "العقد"): @(Model.Contract?.ContractNo ?? "—")</p>
                        <p class="text-[11px] text-ink-500">@L.T("Method", "الطريقة"): @L.E(Model.Method)</p>
                        @if (Model.Fund is not null)
                        {
                            <p class="text-[11px] text-ink-500">@L.T("Fund", "الصندوق"): @L.Pick(Model.Fund.NameAr, Model.Fund.NameEn)</p>
                        }
                    </div>
                </section>

                <section class="mt-6">
                    <p class="text-[10px] font-bold uppercase tracking-wide text-ink-400">@L.T("Statement details", "تفاصيل الكشف")</p>
                    <div class="mt-2 overflow-hidden rounded-xl border border-sand-200">
                        <table class="w-full text-[11px]">
                            <thead class="bg-sand-50 text-ink-500">
                                <tr>
                                    <th class="px-3 py-2 text-start font-semibold">@L.T("Kind", "النوع")</th>
                                    <th class="px-3 py-2 text-start font-semibold">@L.T("Description", "الوصف")</th>
                                    <th class="px-3 py-2 text-end font-semibold">@L.T("Amount", "المبلغ")</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var line in Model.Lines.OrderBy(l => l.Kind).ThenBy(l => l.Id))
                            {
                                <tr class="border-t border-sand-100">
                                    <td class="px-3 py-1.5 text-ink-600">@L.E(line.Kind)</td>
                                    <td class="px-3 py-1.5 text-ink-800">@line.Description</td>
                                    <td class="px-3 py-1.5 text-end font-mono">@L.Money(line.Amount)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3 space-y-1 text-[11px]">
                        <div class="flex justify-between"><span class="text-ink-500">@L.T("Gross earnings", "إجمالي المستحقات")</span><span class="font-mono">@L.Money(Model.Gross)</span></div>
                        <div class="flex justify-between"><span class="text-ink-500">@L.T("Adjustments", "التعديلات")</span><span class="font-mono text-emerald-700">@L.Money(Model.Adjustments)</span></div>
                        <div class="flex justify-between"><span class="text-ink-500">@L.T("Deductions", "الاستقطاعات")</span><span class="font-mono text-red-600">@L.Money(Model.Deductions)</span></div>
                        <div class="mt-2 flex items-center justify-between rounded-xl bg-brand-950 px-4 py-3 text-white">
                            <span class="text-xs font-semibold">@L.T("Net paid", "الصافي المصروف")</span>
                            <span class="font-mono text-lg font-extrabold text-gold-300">@L.Money(Model.Net)</span>
                        </div>
                    </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p class="mt-4 text-[11px] leading-6 text-ink-500"><span class="font-bold text-ink-700">@L.T("Notes", "ملاحظات"):</span> @Model.Notes</p>
                }

                <p class="mt-4 text-[11px] text-ink-600">
                    @L.T("Amount in figures", "المبلغ رقماً"): <strong class="font-mono">@L.Money(Model.Net)</strong>
                </p>

                <section class="mt-10 grid grid-cols-2 gap-8 text-center text-[10px] text-ink-500">
                    <div>
                        <div class="mx-auto h-12 border-b border-dashed border-ink-300"></div>
                        <p class="mt-2 font-semibold">@L.T("Teacher signature", "توقيع المدرّس")</p>
                        <p>@L.Pick(Model.Teacher.FullNameAr, Model.Teacher.FullNameEn)</p>
                    </div>
                    <div>
                        <div class="mx-auto h-12 border-b border-dashed border-ink-300"></div>
                        <p class="mt-2 font-semibold">@L.T("Accountant / Manager", "المحاسب / المدير")</p>
                        <p>@(Model.PaidByName ?? Model.ApprovedByName ?? "—")</p>
                    </div>
                </section>

                <footer class="mt-8 border-t border-sand-200 pt-3 text-center text-[9px] leading-5 text-ink-400">
                    <p>@L.T("This voucher is computer generated and valid without a handwritten stamp.", "هذا السند صادر إلكترونياً وصالح دون ختم يدوي.")</p>
                    <p>@L.Pick(settings.AddressAr, settings.AddressEn) · @settings.Email · @settings.Phone</p>
                </footer>
            </div>
        </article>
    </div>
</body>
</html>

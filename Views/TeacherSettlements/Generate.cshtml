@model GenerateSettlementViewModel
@{
    ViewData["Title"] = L.T("Generate statement", "إنشاء كشف");
    var teachers = ViewBag.Teachers as List<Teacher> ?? new();
    var selected = ViewBag.SelectedTeacher as Teacher;
    var contract = ViewBag.Contract as TeacherContract;
    var unsettledCount = (int)ViewBag.UnsettledCount;
    var unsettledAmount = (long)ViewBag.UnsettledAmount;
}
<div class="page-head">
    <div>
        <h1 class="page-title">@L.T("Generate settlement statement", "إنشاء كشف تسوية")</h1>
        <p class="page-sub">@L.T("Bundles every unsettled earning in the period into one draft statement. Earnings already on another statement are skipped.", "يجمع كل المستحقات غير المسواة في الفترة بكشف مسودة واحد، ويتجاهل المستحقات المدرجة في كشوف أخرى.")</p>
    </div>
    <div class="flex gap-2">
        <a asp-action="Index" class="btn btn-outline btn-sm"><svg class="h-4 w-4 flip-x"><use href="#i-arrow-left"/></svg>@L.T("Settlements", "التسويات")</a>
        <a asp-action="Contracts" class="btn btn-ghost btn-sm">@L.T("Contracts", "العقود")</a>
    </div>
</div>

<form method="get" asp-action="Generate" class="card card-pad">
    <label class="label" for="teacherId">@L.T("Teacher", "المدرّس")</label>
    <div class="flex flex-col gap-2 sm:flex-row">
        <select id="teacherId" name="teacherId" class="select" onchange="this.form.submit()">
            <option value="">@L.T("Select teacher…", "اختر المدرّس…")</option>
            @foreach (var t in teachers)
            {
                <option value="@t.Id" selected="@(Model.TeacherId == t.Id)">@L.Pick(t.FullNameAr, t.FullNameEn) · @t.Code</option>
            }
        </select>
        <noscript><button class="btn btn-outline">@L.T("Load", "تحميل")</button></noscript>
    </div>
</form>

@if (Model.TeacherId > 0 && selected is not null)
{
    <div class="mt-5 grid gap-5 lg:grid-cols-3">
        <div class="card card-pad lg:col-span-2">
            <h2 class="section-title">@L.T("Period & notes", "الفترة والملاحظات")</h2>
            <form method="post" asp-action="Generate" class="mt-4 space-y-3">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TeacherId" />
                <div class="grid gap-3 sm:grid-cols-2">
                    <div>
                        <label class="label" asp-for="PeriodStart">@L.T("Period start", "بداية الفترة")</label>
                        <input asp-for="PeriodStart" type="date" class="input" />
                    </div>
                    <div>
                        <label class="label" asp-for="PeriodEnd">@L.T("Period end", "نهاية الفترة")</label>
                        <input asp-for="PeriodEnd" type="date" class="input" />
                    </div>
                </div>
                <div>
                    <label class="label" asp-for="Notes">@L.T("Statement notes", "ملاحظات الكشف")</label>
                    <textarea asp-for="Notes" class="textarea" rows="2" placeholder="@L.T("Optional note shown on the statement and voucher…", "ملاحظة اختيارية تظهر على الكشف وسند الصرف…")"></textarea>
                </div>
                <div class="flex justify-end">
                    <button class="btn btn-primary" @(unsettledCount == 0 && !(contract?.CompensationType == TeacherCompensationType.FixedMonthly) ? "disabled" : "")>
                        <svg class="h-4 w-4"><use href="#i-sparkles"/></svg>@L.T("Generate draft statement", "إنشاء كشف مسودة")
                    </button>
                </div>
            </form>
        </div>

        <div class="space-y-4">
            <div class="card card-pad">
                <h2 class="section-title">@L.T("Teacher summary", "ملخص المدرّس")</h2>
                <p class="mt-2 text-sm font-bold text-brand-950">@L.Pick(selected.FullNameAr, selected.FullNameEn)</p>
                <p class="text-[11px] text-ink-500">@selected.Code · @selected.Specialization</p>
                <dl class="mt-3 space-y-2 text-xs">
                    <div class="flex justify-between"><dt class="text-ink-500">@L.T("Unsettled entries", "قيود غير مسواة")</dt><dd class="font-semibold">@L.Num(unsettledCount)</dd></div>
                    <div class="flex justify-between"><dt class="text-ink-500">@L.T("Unsettled amount", "المبلغ غير المسوى")</dt><dd class="font-bold text-amber-700">@L.Money(unsettledAmount)</dd></div>
                </dl>
            </div>

            <div class="card card-pad !bg-brand-50">
                <h2 class="section-title">@L.T("Compensation terms", "شروط الأجر")</h2>
                @if (contract is null)
                {
                    <div class="alert alert-warning mt-3"><svg class="h-4 w-4"><use href="#i-info"/></svg><p>@L.T("No active contract. Only already-accrued earnings can be settled.", "لا يوجد عقد نشط. يمكن تسوية المستحقات المتراكمة فقط.")</p></div>
                }
                else
                {
                    <p class="mt-2 font-mono text-[11px] text-brand-900">@contract.ContractNo</p>
                    <dl class="mt-2 space-y-2 text-xs">
                        <div class="flex justify-between"><dt class="text-brand-800">@L.T("Type", "النوع")</dt><dd class="font-semibold">@L.E(contract.CompensationType)</dd></div>
                        @if (contract.CompensationType == TeacherCompensationType.PercentageCollected)
                        {
                            <div class="flex justify-between"><dt class="text-brand-800">@L.T("Share", "الحصة")</dt><dd class="font-semibold">@L.Percent(contract.SharePercent)</dd></div>
                        }
                        else
                        {
                            <div class="flex justify-between"><dt class="text-brand-800">@L.T("Monthly", "الشهري")</dt><dd class="font-semibold">@L.Money(contract.FixedMonthlyAmount)</dd></div>
                        }
                        <div class="flex justify-between"><dt class="text-brand-800">@L.T("Since", "منذ")</dt><dd>@L.DateShort(contract.StartDate)</dd></div>
                    </dl>
                }
                <p class="mt-3 text-[10px] leading-5 text-brand-800">@L.T("A fixed retainer is added only for a full calendar month and only once per month.", "يُضاف المخصص الثابت لشهر ميلادي كامل فقط ومرة واحدة لكل شهر.")</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="card mt-5"><div class="empty">@L.T("Select a teacher to preview their unsettled earnings and contract terms.", "اختر مدرّساً لمعاينة مستحقاته غير المسواة وشروط عقده.")</div></div>
}

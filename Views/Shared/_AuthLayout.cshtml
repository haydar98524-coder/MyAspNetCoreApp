@{
    var settings = await Db.Settings.AsNoTracking().FirstOrDefaultAsync(s => s.Id == 1);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@L.Lang" dir="@L.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#032b28" />
    <title>@(ViewData["Title"] ?? L.T("Sign in", "تسجيل الدخول")) · @L.T("Kirkuk National Institute", "معهد كركوك الأهلي")</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
</head>
<body class="min-h-screen bg-sand-50">
    @await Html.PartialAsync("_Icons")
    <div class="grid min-h-screen lg:grid-cols-[1.05fr_1fr]">
        <aside class="relative hidden overflow-hidden bg-brand-950 p-10 lg:flex lg:flex-col lg:justify-between">
            <div class="pointer-events-none absolute -end-24 -top-24 h-96 w-96 rounded-full bg-brand-700/30 blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-32 -start-20 h-96 w-96 rounded-full bg-gold-500/10 blur-3xl"></div>
            <div class="pointer-events-none absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 26px 26px;"></div>
            <div class="relative">
                @await Html.PartialAsync("_Logo", "dark")
                <div class="mt-16 max-w-lg">
                    <p class="text-[11px] font-bold uppercase tracking-[0.24em] text-gold-400">@L.T("Unified education & finance platform", "منصة تعليمية ومالية متكاملة")</p>
                    <h1 class="mt-4 text-4xl font-extrabold leading-[1.25] text-white">@L.T("One place to run your institute, from enrollment to the final account.", "مكان واحد لإدارة معهدك، من التسجيل حتى الحساب الختامي.")</h1>
                    <p class="mt-5 text-sm leading-7 text-brand-100/70">@L.T("Students, attendance, teacher shares, rent contracts, payroll and double-entry accounting — designed around the Iraqi curriculum and daily institute operations.", "الطلاب، الحضور، مستحقات المدرسين، عقود الإيجار، الرواتب والمحاسبة المزدوجة — بتصميم يلائم المنهج العراقي وروتين المعهد اليومي.")</p>
                </div>
                <div class="mt-10 grid max-w-lg grid-cols-2 gap-3">
                    <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                        <p class="text-2xl font-extrabold text-gold-300">@settings?.AcademicYear</p>
                        <p class="mt-1 text-xs text-brand-100/60">@L.T("Current academic year", "العام الدراسي الحالي")</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                        <p class="text-2xl font-extrabold text-gold-300">@L.Num(await Db.Students.CountAsync(s => s.Status == StudentStatus.Active))</p>
                        <p class="mt-1 text-xs text-brand-100/60">@L.T("Active students", "طالب منتظم")</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                        <p class="text-2xl font-extrabold text-gold-300">@L.Num(await Db.Teachers.CountAsync(t => t.IsActive))</p>
                        <p class="mt-1 text-xs text-brand-100/60">@L.T("Teachers on staff", "مدرس في الكادر")</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                        <p class="text-2xl font-extrabold text-gold-300">@L.Num(await Db.Courses.CountAsync(c => c.Status == CourseStatus.Active))</p>
                        <p class="mt-1 text-xs text-brand-100/60">@L.T("Running courses", "دورة نشطة")</p>
                    </div>
                </div>
            </div>
            <div class="relative flex items-center justify-between gap-4 border-t border-white/10 pt-6 text-[11px] text-brand-100/50">
                <span>@L.T("Kirkuk, Iraq · License", "كركوك، العراق · إجازة") @settings?.LicenseNo</span>
                <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-1 font-bold text-brand-100 hover:text-white">
                    @L.T("Back to website", "العودة للموقع")
                    <svg class="h-3.5 w-3.5"><use href="#i-arrow-right"/></svg>
                </a>
            </div>
        </aside>

        <section class="flex flex-col">
            <div class="flex items-center justify-between px-5 py-5 sm:px-8">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 text-sm font-bold text-brand-800 hover:text-brand-950">
                    <svg class="h-4 w-4 flip-x"><use href="#i-arrow-left"/></svg>
                    @L.T("Home", "الرئيسية")
                </a>
                <div class="flex items-center gap-2">
                    <a asp-controller="Account" asp-action="SetLanguage" asp-route-lang="@L.OtherLang" asp-route-returnUrl="@returnUrl" class="btn btn-outline !rounded-full !px-3 !py-1.5 !text-xs">
                        <svg class="h-4 w-4"><use href="#i-globe"/></svg>
                        @(L.IsArabic ? "English" : "العربية")
                    </a>
                </div>
            </div>
            <div class="flex flex-1 items-center justify-center px-5 pb-10 sm:px-8">
                <div class="w-full max-w-md">
                    <div class="mb-8 lg:hidden">@await Html.PartialAsync("_Logo", "light")</div>
                    @RenderBody()
                    <p class="mt-8 text-center text-[11px] text-ink-500">© @DateTime.Today.Year @L.T("Kirkuk National Institute · all rights reserved", "معهد كركوك الأهلي · جميع الحقوق محفوظة")</p>
                </div>
            </div>
        </section>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>

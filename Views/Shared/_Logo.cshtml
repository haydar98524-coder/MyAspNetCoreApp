@model string
@{
    var dark = Model == "dark";
}
<div class="flex items-center gap-3">
    <span class="relative flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-br from-gold-300 via-gold-500 to-gold-700 shadow-lg shadow-brand-950/20 ring-1 ring-white/20">
        <svg viewBox="0 0 32 32" class="h-7 w-7" fill="none" aria-hidden="true">
            <path d="M5.5 9.3c3.5-1.5 7-1 10.5 1.4 3.5-2.4 7-2.9 10.5-1.4v13.4c-3.5-1.3-7-.8-10.5 1.5-3.5-2.3-7-2.8-10.5-1.5V9.3Z" fill="white" fill-opacity=".95"/>
            <path d="M16 10.7v13.5" stroke="#855a1a" stroke-width="1.2" stroke-linecap="round"/>
            <path d="M8.7 12.7c1.9-.4 3.5-.1 5 .7M8.7 15.7c1.9-.4 3.5-.1 5 .7M8.7 18.7c1.9-.4 3.5-.1 5 .7M23.3 12.7c-1.9-.4-3.5-.1-5 .7M23.3 15.7c-1.9-.4-3.5-.1-5 .7" stroke="#a67c1e" stroke-width="1" stroke-linecap="round"/>
            <path d="m16 2.8.8 1.8 1.9.2-1.4 1.4.4 1.9-1.7-.9-1.7.9.4-1.9-1.4-1.4 1.9-.2L16 2.8Z" fill="#032b28" fill-opacity=".8"/>
        </svg>
    </span>
    <span class="leading-tight">
        <span class="block text-[14px] font-extrabold tracking-tight @(dark ? "text-white" : "text-brand-950")">@L.T("Kirkuk National Institute", "معهد كركوك الأهلي")</span>
        <span class="mt-0.5 block text-[10px] font-semibold uppercase tracking-[0.18em] @(dark ? "text-brand-100/60" : "text-ink-500")">@L.T("for Tutoring · Kirkuk", "لدورات التقوية · كركوك")</span>
    </span>
</div>

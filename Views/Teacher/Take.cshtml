@model TakeAttendanceViewModel
@{
    ViewData["Title"] = L.T("Take attendance", "تسجيل الحضور");
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="page-head">
    <div>
        <div class="flex items-center gap-2 text-xs text-ink-500">
            <a asp-action="Attendance" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" class="link">@L.T("Attendance register", "سجل الحضور")</a>
            <svg class="h-3.5 w-3.5"><use href="#i-chevron-down"/></svg>
            <span>@Model.CourseName</span>
        </div>
        <h1 class="page-title mt-1">@Model.CourseName · @Model.SectionName</h1>
        <p class="page-sub">@L.Date(Model.Date) · @L.Day(Model.Date.DayOfWeek) · @L.Num(Model.Students.Count) @L.T("students", "طالباً")</p>
    </div>
    <div class="flex items-center gap-2">
        <a asp-action="Attendance" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" class="btn btn-outline btn-sm">
            <svg class="h-4 w-4 flip-x"><use href="#i-arrow-left"/></svg>@L.T("Back", "رجوع")
        </a>
        <a asp-action="Schedule" class="btn btn-ghost btn-sm"><svg class="h-4 w-4"><use href="#i-calendar"/></svg>@L.T("Schedule", "الجدول")</a>
    </div>
</div>

@if (Model.AlreadyRecorded)
{
    <div class="alert alert-info mb-5">
        <svg class="mt-0.5 h-5 w-5 shrink-0"><use href="#i-shield"/></svg>
        <div>
            <p class="font-bold">@L.T("Attendance already recorded", "تم تسجيل الحضور مسبقاً")</p>
            <p class="mt-0.5 text-xs">@L.T("Saved records cannot be edited directly. Submit a change request with a reason; a manager must approve it before the register is updated.",
                "لا يمكن تعديل السجل المحفوظ مباشرة. أرسل طلب تعديل مع ذكر السبب، ويجب أن يعتمده المدير قبل تحديث السجل.")</p>
        </div>
    </div>

    <div class="card overflow-hidden">
        <div class="table-wrap">
            <table class="table-base">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L.T("Student", "الطالب")</th>
                        <th>@L.T("Status", "الحالة")</th>
                        <th>@L.T("Note", "ملاحظة")</th>
                        <th class="text-end">@L.T("Request correction", "طلب تعديل")</th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Students.Count; i++)
                {
                    var mark = Model.Students[i];
                    <tr>
                        <td class="text-xs text-ink-400">@(i + 1)</td>
                        <td><p class="font-semibold text-ink-900">@mark.StudentName</p></td>
                        <td>
                            @switch (mark.Status)
                            {
                                case AttendanceStatus.Present: <span class="badge badge-green">@L.E(mark.Status)</span> break;
                                case AttendanceStatus.Absent: <span class="badge badge-red">@L.E(mark.Status)</span> break;
                                case AttendanceStatus.Late: <span class="badge badge-amber">@L.E(mark.Status)</span> break;
                                default: <span class="badge badge-blue">@L.E(mark.Status)</span> break;
                            }
                        </td>
                        <td class="max-w-52 text-xs text-ink-500">@(mark.ExistingNote ?? "—")</td>
                        <td>
                            <details class="group">
                                <summary class="btn btn-soft btn-xs cursor-pointer list-none justify-end"><svg class="h-3.5 w-3.5"><use href="#i-edit"/></svg>@L.T("Request change", "طلب تعديل")</summary>
                                <form asp-controller="Attendance" asp-action="RequestChange" method="post" class="mt-3 grid gap-2 rounded-xl border border-sand-200 bg-sand-50 p-3 sm:grid-cols-[1fr_1fr_auto]">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="attendanceId" value="@mark.AttendanceId" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <select name="newStatus" class="select !py-2">
                                        @foreach (var st in Enum.GetValues<AttendanceStatus>())
                                        {
                                            <option value="@st" selected="@(st == mark.Status ? "selected" : null)">@L.E(st)</option>
                                        }
                                    </select>
                                    <input name="reason" class="input !py-2" placeholder="@L.T("Reason for the correction…", "سبب التعديل…")" required minlength="5" />
                                    <button class="btn btn-primary btn-sm">@L.T("Send", "إرسال")</button>
                                </form>
                            </details>
                        </td>
                    </tr>
                }
                @if (Model.Students.Count == 0)
                {
                    <tr><td colspan="5"><div class="empty">@L.T("No students are enrolled in this section.", "لا يوجد طلاب مسجلون في هذه الشعبة.")</div></td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <form asp-action="Save" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SectionId" />
        <input type="hidden" asp-for="SectionName" />
        <input type="hidden" asp-for="CourseName" />
        <input type="hidden" asp-for="TeacherName" />
        <input type="hidden" asp-for="Date" />

        <div class="card card-pad !py-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span class="stat-icon bg-brand-50 text-brand-700"><svg class="h-5 w-5"><use href="#i-clipboard"/></svg></span>
                    <div>
                        <p class="text-sm font-bold text-brand-950">@L.T("Roster", "قائمة الطلاب")</p>
                        <p class="text-xs text-ink-500">@L.Num(Model.Students.Count) @L.T("students · default status is present", "طالباً · الحالة الافتراضية حاضر")</p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <button type="button" class="btn btn-outline btn-sm" data-mark-all="Present">@L.T("All present", "الكل حاضر")</button>
                    <button type="button" class="btn btn-outline btn-sm" data-mark-all="Absent">@L.T("All absent", "الكل غائب")</button>
                </div>
            </div>
        </div>

        <div class="card overflow-hidden">
            <div class="table-wrap">
                <table class="table-base">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L.T("Student", "الطالب")</th>
                            <th>@L.T("Attendance", "الحضور")</th>
                            <th class="w-56">@L.T("Note (optional)", "ملاحظة (اختياري)")</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Students.Count; i++)
                    {
                        var mark = Model.Students[i];
                        <tr data-student-row>
                            <td class="text-xs text-ink-400">@(i + 1)</td>
                            <td>
                                <input type="hidden" asp-for="Students[i].StudentId" />
                                <input type="hidden" asp-for="Students[i].StudentName" />
                                <div class="flex items-center gap-2">
                                    <span class="avatar h-8 w-8 bg-brand-100 text-[11px] text-brand-800">@L.Initials(mark.StudentName)</span>
                                    <p class="font-semibold text-ink-900">@mark.StudentName</p>
                                </div>
                            </td>
                            <td>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var st in Enum.GetValues<AttendanceStatus>())
                                    {
                                        <label class="cursor-pointer">
                                            <input type="radio" name="Students[@i].Status" value="@st" class="peer sr-only" checked="@(mark.Status == st)" />
                                            <span class="inline-flex items-center rounded-full border border-sand-300 bg-white px-3 py-1 text-[11px] font-bold text-ink-500 transition peer-checked:border-transparent peer-checked:bg-brand-800 peer-checked:text-white">
                                                @L.E(st)
                                            </span>
                                        </label>
                                    }
                                </div>
                            </td>
                            <td><input asp-for="Students[i].ExistingNote" class="input !py-2 !text-xs" placeholder="@L.T("Optional note…", "ملاحظة اختيارية…")" /></td>
                        </tr>
                    }
                    @if (Model.Students.Count == 0)
                    {
                        <tr><td colspan="4"><div class="empty">@L.T("No students are enrolled in this section.", "لا يوجد طلاب مسجلون في هذه الشعبة.")</div></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-sand-200 bg-white px-5 py-4 shadow-card">
            <p class="text-xs text-ink-500">
                <svg class="inline h-4 w-4 text-brand-600"><use href="#i-info"/></svg>
                @L.T("After saving, changes require a manager-approved request.", "بعد الحفظ، أي تعديل يتطلب طلباً معتمداً من الإدارة.")
            </p>
            <div class="flex gap-2">
                <a asp-action="Attendance" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" class="btn btn-outline">@L.T("Cancel", "إلغاء")</a>
                <button class="btn btn-primary" disabled="@(Model.Students.Count == 0)">
                    <svg class="h-4 w-4"><use href="#i-check"/></svg>@L.T("Save attendance", "حفظ الحضور")
                </button>
            </div>
        </div>
    </form>
}

@section Scripts {
<script>
    document.querySelectorAll('[data-mark-all]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var status = btn.getAttribute('data-mark-all');
            document.querySelectorAll('tr[data-student-row]').forEach(function (row) {
                var input = row.querySelector('input[type=radio][value="' + status + '"]');
                if (input) input.checked = true;
            });
        });
    });
</script>
}

@model ExpenseFormViewModel
@{
    ViewData["Title"] = L.T("New expense", "مصروف جديد");
    var accounts = ViewBag.Accounts as List<Account> ?? new List<Account>();
    var funds = ViewBag.Funds as List<Fund> ?? new List<Fund>();
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
}
<div class="page-head">
    <div>
        <h1 class="page-title">@L.T("New expense", "مصروف جديد")</h1>
        <p class="page-sub">@L.T("Recorded as a balanced entry: expense account (debit) against the selected fund (credit).", "يُسجل بقيد متوازن: حساب المصروف مديناً مقابل الصندوق دائناً.")</p>
    </div>
    <a asp-action="Expenses" class="btn btn-outline btn-sm"><svg class="h-4 w-4 flip-x"><use href="#i-arrow-left"/></svg>@L.T("Expenses", "المصروفات")</a>
</div>

<form asp-action="CreateExpense" method="post" enctype="multipart/form-data" class="grid gap-4 lg:grid-cols-3">
    @Html.AntiForgeryToken()
    <div class="lg:col-span-2 card card-pad">
        <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4 @(ViewData.ModelState.ErrorCount == 0 ? "hidden" : "")"></div>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
                <label class="label">@L.T("Expense account", "حساب المصروف")</label>
                <select asp-for="AccountId" class="select">
                    <option value="0">@L.T("Select account…", "اختر الحساب…")</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code · @L.Pick(account.NameAr, account.NameEn)</option>
                    }
                </select>
                <span asp-validation-for="AccountId" class="field-error"></span>
            </div>
            <div>
                <label class="label">@L.T("Amount (IQD)", "المبلغ (د.ع)")</label>
                <input asp-for="Amount" type="number" min="1" step="1000" class="input text-end tabular-nums" />
                <span asp-validation-for="Amount" class="field-error"></span>
            </div>
            <div>
                <label class="label">@L.T("Date", "التاريخ")</label>
                <input asp-for="Date" type="date" class="input" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Date" class="field-error"></span>
            </div>
            <div>
                <label class="label">@L.T("Vendor / beneficiary", "المورد / الجهة")</label>
                <input asp-for="Vendor" class="input" placeholder="@L.T("e.g. Kirkuk Electricity Directorate", "مثال: مديرية كهرباء كركوك")" />
                <span asp-validation-for="Vendor" class="field-error"></span>
            </div>
            <div>
                <label class="label">@L.T("Payment method", "طريقة الدفع")</label>
                <select asp-for="Method" class="select">
                    @foreach (var m in Enum.GetValues<PaymentMethod>()) { <option value="@m">@L.E(m)</option> }
                </select>
            </div>
            <div class="sm:col-span-2">
                <label class="label">@L.T("Description", "الوصف")</label>
                <input asp-for="Description" class="input" placeholder="@L.T("What was paid for?", "ما الذي دُفع مقابله؟")" />
                <span asp-validation-for="Description" class="field-error"></span>
            </div>
            <div>
                <label class="label">@L.T("Fund", "الصندوق")</label>
                <select asp-for="FundId" class="select">
                    <option value="">@L.T("Auto by payment method", "تلقائي حسب طريقة الدفع")</option>
                    @foreach (var fund in funds)
                    {
                        <option value="@fund.Id">@L.Pick(fund.NameAr, fund.NameEn)</option>
                    }
                </select>
            </div>
            <div>
                <label class="label">@L.T("Link to course (optional)", "ربط بدورة (اختياري)")</label>
                <select asp-for="CourseId" class="select">
                    <option value="">@L.T("General expense", "مصروف عام")</option>
                    @foreach (var course in courses)
                    {
                        <option value="@course.Id">@course.Code · @L.Pick(course.NameAr, course.NameEn)</option>
                    }
                </select>
            </div>
            <div class="sm:col-span-2">
                <label class="label">@L.T("Receipt / invoice (optional)", "السند / الفاتورة (اختياري)")</label>
                <input asp-for="Attachment" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf" class="input !py-2" />
                <p class="help">@L.T("JPG, PNG, WEBP or PDF up to 5 MB.", "JPG أو PNG أو WEBP أو PDF بحد أقصى 5 ميغابايت.")</p>
                <span asp-validation-for="Attachment" class="field-error"></span>
            </div>
        </div>
    </div>

    <div class="space-y-4">
        <div class="card card-pad">
            <p class="text-sm font-bold text-brand-950">@L.T("Posting", "الترحيل")</p>
            <label class="mt-3 flex items-start gap-2 rounded-xl border border-sand-200 p-3 text-xs">
                <input asp-for="PostNow" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-sand-300 text-brand-700 focus:ring-brand-500" />
                <span>
                    <span class="block font-bold text-ink-900">@L.T("Post to the ledger now", "ترحيل إلى دفتر الأستاذ الآن")</span>
                    <span class="mt-0.5 block text-ink-500">@L.T("If unchecked, the expense is saved as a draft and can be approved later.", "إذا لم يُحدد، يُحفظ المصروف كمسودة ويمكن اعتماده لاحقاً.")</span>
                </span>
            </label>
            <p class="mt-3 rounded-xl bg-sand-50 p-3 text-[11px] text-ink-500">
                @L.T("Posting reduces the fund balance immediately and cannot be deleted; use an adjusting entry if needed.", "الترحيل يخفض رصيد الصندوق فوراً ولا يمكن حذفه؛ استخدم قيد تسوية عند الحاجة.")
            </p>
        </div>
        <div class="flex flex-col gap-2">
            <button class="btn btn-primary w-full"><svg class="h-4 w-4"><use href="#i-check"/></svg>@L.T("Save expense", "حفظ المصروف")</button>
            <a asp-action="Expenses" class="btn btn-outline w-full">@L.T("Cancel", "إلغاء")</a>
        </div>
    </div>
</form>

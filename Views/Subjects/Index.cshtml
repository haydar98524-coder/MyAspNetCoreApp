@model List<Subject>
@{
    ViewData["Title"] = L.T("Subjects", "المواد");
    var teacherCounts = ViewBag.Teachers as Dictionary<int, int> ?? new();
}
<div class="page-head">
    <div>
        <h1 class="page-title">@L.T("Subjects", "المواد الدراسية")</h1>
        <p class="page-sub">@L.Num(Model.Count) @L.T("subjects across the Iraqi curriculum", "مادة ضمن المنهج العراقي")</p>
    </div>
</div>

<div class="grid gap-5 lg:grid-cols-3">
    <div class="lg:col-span-2">
        <div class="grid gap-3 sm:grid-cols-2">
            @foreach (var s in Model)
            {
                <div class="card p-4">
                    <div class="flex items-start justify-between gap-2">
                        <div class="flex items-center gap-3">
                            <span class="flex h-10 w-10 items-center justify-center rounded-xl text-sm font-extrabold text-white" style="background:@s.Color">@s.Code</span>
                            <div>
                                <p class="font-bold text-brand-950">@L.Pick(s.NameAr, s.NameEn)</p>
                                <p class="text-[11px] text-ink-500">@s.NameEn · @L.Pick(s.NameAr, s.NameEn)</p>
                            </div>
                        </div>
                        <span class="badge @(s.IsActive ? "badge-green" : "badge-gray")">@(s.IsActive ? L.T("Active", "نشطة") : L.T("Inactive", "موقوفة"))</span>
                    </div>
                    <div class="mt-3 flex gap-3 text-[11px] text-ink-500">
                        <span class="chip !px-2 !py-0.5">@L.Num(s.Courses.Count) @L.T("courses", "دورة")</span>
                        <span class="chip !px-2 !py-0.5">@L.Num(teacherCounts.GetValueOrDefault(s.Id)) @L.T("teachers", "مدرّس")</span>
                    </div>
                    <details class="mt-3 border-t border-sand-200 pt-2">
                        <summary class="cursor-pointer text-[11px] font-bold text-brand-700">@L.T("Edit subject", "تعديل المادة")</summary>
                        <form asp-action="Edit" method="post" class="mt-3 space-y-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <div class="grid grid-cols-2 gap-2">
                                <input name="nameAr" value="@s.NameAr" class="input !py-1.5 !text-xs" required />
                                <input name="nameEn" value="@s.NameEn" class="input !py-1.5 !text-xs" dir="ltr" required />
                                <input name="code" value="@s.Code" class="input !py-1.5 !text-xs" dir="ltr" />
                                <input name="color" type="color" value="@s.Color" class="input !h-9 !py-1" />
                            </div>
                            <label class="flex items-center gap-2 text-xs font-semibold text-ink-700"><input type="checkbox" name="isActive" value="true" class="checkbox" checked="@s.IsActive" />@L.T("Active", "نشطة")</label>
                            <button class="btn btn-soft btn-xs w-full">@L.T("Save", "حفظ")</button>
                        </form>
                    </details>
                </div>
            }
        </div>
    </div>

    <div>
        <div class="card card-pad">
            <h2 class="section-title mb-4">@L.T("Add a subject", "إضافة مادة")</h2>
            <form asp-action="Create" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <div><label class="label">@L.T("Name (Arabic)", "الاسم (عربي)")</label><input name="nameAr" class="input" required placeholder="الرياضيات" /></div>
                <div><label class="label">@L.T("Name (English)", "الاسم (إنكليزي)")</label><input name="nameEn" class="input" dir="ltr" required placeholder="Mathematics" /></div>
                <div><label class="label">@L.T("Code", "الرمز")</label><input name="code" class="input" dir="ltr" placeholder="MATH" /></div>
                <div><label class="label">@L.T("Colour", "اللون")</label><input name="color" type="color" value="#0f766e" class="input !h-10 !p-1" /></div>
                <button class="btn btn-primary w-full"><svg class="h-4 w-4"><use href="#i-plus"/></svg>@L.T("Add subject", "إضافة المادة")</button>
            </form>
        </div>
        <div class="card card-pad mt-4 !bg-brand-50">
            <p class="text-xs leading-6 text-brand-800">@L.T("Subjects are shared across primary, intermediate and preparatory stages. Grade-branch specificity (scientific / literary) is handled at course level.", "المواد مشتركة بين المراحل الابتدائية والمتوسطة والإعدادية. تخصيص الفرع (علمي / أدبي) يتم على مستوى الدورة.")</p>
        </div>
    </div>
</div>

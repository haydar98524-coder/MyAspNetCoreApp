@model Student
@{
    ViewData["Title"] = Model.FullNameAr;
    var attendance = ViewBag.Attendance as List<StudentAttendance> ?? new();
    var results = ViewBag.Results as List<ExamResult> ?? new();
    var remaining = Model.Dues.Where(d => d.Status != DueStatus.Paid && d.Status != DueStatus.Waived).Sum(d => d.Remaining);
    var paid = Model.Payments.Sum(p => p.Amount);
    var billed = Model.Enrollments.Sum(e => e.NetFee);
    var attTotal = Model.Attendances.Count;
    var attPresent = Model.Attendances.Count(a => a.Status is AttendanceStatus.Present or AttendanceStatus.Late);
    var attRate = attTotal == 0 ? 0 : (int)Math.Round(attPresent * 100.0 / attTotal);
    var canEdit = User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Registrar);
    var canBill = User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Accountant) || User.IsInRole(Roles.Registrar);
    var statusBadge = Model.Status switch
    {
        StudentStatus.Active => "badge-green",
        StudentStatus.Suspended => "badge-amber",
        StudentStatus.Graduated => "badge-blue",
        _ => "badge-gray"
    };
}
<div class="page-head">
    <div>
        <div class="mb-1 flex items-center gap-2 text-xs text-ink-500">
            <a asp-action="Index" class="hover:text-brand-700">@L.T("Students", "الطلاب")</a>
            <svg class="h-3 w-3 flip-x"><use href="#i-chevron-down"/></svg>
            <span>@Model.StudentNo</span>
        </div>
        <h1 class="page-title">@L.Pick(Model.FullNameAr, Model.FullNameEn)</h1>
        <p class="page-sub">@L.Pick(Model.Grade.NameAr, Model.Grade.NameEn) · @L.E(Model.Grade.Stage.Type) · @L.Age(Model.BirthDate)</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline btn-sm no-print">@L.T("Back", "رجوع")</a>
        @if (canBill)
        {
            <a asp-controller="Payments" asp-action="Collect" asp-route-studentId="@Model.Id" class="btn btn-soft btn-sm"><svg class="h-4 w-4"><use href="#i-cash"/></svg>@L.T("Collect payment", "تحصيل دفعة")</a>
            <a asp-controller="Enrollments" asp-action="Create" asp-route-studentId="@Model.Id" class="btn btn-gold btn-sm"><svg class="h-4 w-4"><use href="#i-plus"/></svg>@L.T("New enrollment", "اشتراك جديد")</a>
        }
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><svg class="h-4 w-4"><use href="#i-edit"/></svg>@L.T("Edit", "تعديل")</a>
        }
    </div>
</div>

<div class="grid gap-5 lg:grid-cols-3">
    <div class="space-y-5 lg:col-span-1">
        <div class="card card-pad text-center">
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <img src="@Model.PhotoPath" alt="" class="mx-auto h-24 w-24 rounded-3xl object-cover shadow-card" />
            }
            else
            {
                <span class="avatar mx-auto h-24 w-24 text-2xl">@L.Initials(Model.FullNameAr)</span>
            }
            <h2 class="mt-3 text-lg font-extrabold text-brand-950">@L.Pick(Model.FullNameAr, Model.FullNameEn)</h2>
            <p class="text-xs text-ink-500">@Model.StudentNo</p>
            <div class="mt-3 flex justify-center gap-1.5">
                <span class="badge @statusBadge">@L.E(Model.Status)</span>
                <span class="badge badge-gray">@L.E(Model.Gender)</span>
            </div>
            <dl class="mt-5 space-y-2.5 border-t border-sand-200 pt-4 text-start text-sm">
                <div class="flex justify-between gap-3"><dt class="text-ink-500">@L.T("Grade", "الصف")</dt><dd class="font-semibold text-ink-900">@L.Pick(Model.Grade.NameAr, Model.Grade.NameEn)</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-ink-500">@L.T("National ID", "الرقم الوطني")</dt><dd class="font-semibold text-ink-900" dir="ltr">@(string.IsNullOrEmpty(Model.NationalId) ? "—" : Model.NationalId)</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-ink-500">@L.T("Hall", "القاعة")</dt><dd class="font-semibold text-ink-900">@(Model.Hall is null ? "—" : L.Pick(Model.Hall.NameAr, Model.Hall.NameEn))</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-ink-500">@L.T("School", "المدرسة")</dt><dd class="font-semibold text-ink-900">@(string.IsNullOrEmpty(Model.SchoolName) ? "—" : Model.SchoolName)</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-ink-500">@L.T("Student phone", "هاتف الطالب")</dt><dd class="font-semibold text-ink-900" dir="ltr">@(Model.Phone ?? "—")</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-ink-500">@L.T("Area", "المنطقة")</dt><dd class="font-semibold text-ink-900">@(string.IsNullOrEmpty(Model.Area) ? "—" : Model.Area)</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-ink-500">@L.T("Registered", "التسجيل")</dt><dd class="font-semibold text-ink-900">@L.DateShort(Model.RegistrationDate)</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-ink-500">@L.T("QR token", "رمز التحقق")</dt><dd class="font-mono text-[10px] text-ink-500" dir="ltr">@Model.QrToken[..Math.Min(10, Model.QrToken.Length)]…</dd></div>
            </dl>
        </div>

        @if (Model.Parent is not null)
        {
            <div class="card card-pad">
                <div class="mb-3 flex items-center justify-between">
                    <h2 class="section-title">@L.T("Guardian", "ولي الأمر")</h2>
                    @if (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Registrar))
                    {
                        <a asp-controller="Parents" asp-action="Details" asp-route-id="@Model.ParentId" class="text-xs link">@L.T("Profile", "الملف")</a>
                    }
                </div>
                <div class="flex items-center gap-3">
                    <span class="avatar h-10 w-10 text-xs">@L.Initials(Model.Parent.FullNameAr)</span>
                    <div class="min-w-0">
                        <p class="truncate text-sm font-bold text-ink-900">@L.Pick(Model.Parent.FullNameAr, Model.Parent.FullNameEn)</p>
                        <a href="tel:@Model.Parent.Phone" class="text-xs text-brand-700" dir="ltr">@Model.Parent.Phone</a>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Parent.Email))
                {
                    <p class="mt-3 flex items-center gap-2 text-xs text-ink-500"><svg class="h-3.5 w-3.5"><use href="#i-mail"/></svg>@Model.Parent.Email</p>
                }
                <p class="mt-1 flex items-center gap-2 text-xs text-ink-500"><svg class="h-3.5 w-3.5"><use href="#i-pin"/></svg>@Model.Parent.Area @Model.Parent.Address</p>
            </div>
        }

        @if (canEdit)
        {
            <div class="card card-pad">
                <h2 class="section-title mb-3">@L.T("Record status", "حالة السجل")</h2>
                <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="flex gap-2">
                    @Html.AntiForgeryToken()
                    <select name="status" class="select">
                        @foreach (var s in Enum.GetValues<StudentStatus>())
                        {
                            <option value="@s" selected="@(s == Model.Status)">@L.E(s)</option>
                        }
                    </select>
                    <button class="btn btn-outline btn-sm">@L.T("Update", "تحديث")</button>
                </form>
            </div>
        }
    </div>

    <div class="space-y-5 lg:col-span-2">
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <div class="stat-card !p-4">
                <p class="text-[11px] font-semibold text-ink-500">@L.T("Outstanding", "المتبقي")</p>
                <p class="mt-1 text-lg font-extrabold @(remaining > 0 ? "text-amber-700" : "text-emerald-700")">@L.Money(remaining)</p>
            </div>
            <div class="stat-card !p-4">
                <p class="text-[11px] font-semibold text-ink-500">@L.T("Total paid", "إجمالي المدفوع")</p>
                <p class="mt-1 text-lg font-extrabold text-brand-950">@L.Money(paid)</p>
            </div>
            <div class="stat-card !p-4">
                <p class="text-[11px] font-semibold text-ink-500">@L.T("Billed", "إجمالي الرسوم")</p>
                <p class="mt-1 text-lg font-extrabold text-brand-950">@L.Money(billed)</p>
            </div>
            <div class="stat-card !p-4">
                <p class="text-[11px] font-semibold text-ink-500">@L.T("Attendance", "الحضور")</p>
                <p class="mt-1 text-lg font-extrabold @(attRate >= 80 ? "text-emerald-700" : "text-amber-700")">@attRate%</p>
            </div>
        </div>

        <div class="card card-pad">
            <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                <h2 class="section-title">@L.T("Academic assignment", "الإسناد الأكاديمي")</h2>
                <span class="text-[11px] text-ink-500">@L.T("Hall, subjects and teachers linked to this student", "القاعة والمواد والمدرسون المرتبطون بهذا الطالب")</span>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <p class="label">@L.T("Subjects", "المواد")</p>
                    <div class="flex flex-wrap gap-1.5">
                        @if (Model.Subjects.Count == 0)
                        {
                            <span class="text-xs text-ink-400">@L.T("No subjects linked.", "لا توجد مواد مرتبطة.")</span>
                        }
                        @foreach (var link in Model.Subjects.OrderBy(x => x.Subject.NameAr))
                        {
                            <span class="chip">
                                <span class="h-2 w-2 rounded-full" style="background:@link.Subject.Color"></span>
                                @L.Pick(link.Subject.NameAr, link.Subject.NameEn)
                            </span>
                        }
                    </div>
                </div>
                <div>
                    <p class="label">@L.T("Teachers", "المدرسون")</p>
                    <div class="flex flex-wrap gap-1.5">
                        @if (Model.Teachers.Count == 0)
                        {
                            <span class="text-xs text-ink-400">@L.T("No teachers linked.", "لا يوجد مدرسون مرتبطون.")</span>
                        }
                        @foreach (var link in Model.Teachers.OrderBy(x => x.Teacher.FullNameAr))
                        {
                            <span class="chip">@L.Pick(link.Teacher.FullNameAr, link.Teacher.FullNameEn)</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="section-title">@L.T("Enrollments", "الاشتراكات")</h2>
                @if (canBill)
                {
                    <a asp-controller="Enrollments" asp-action="Create" asp-route-studentId="@Model.Id" class="btn btn-soft btn-xs"><svg class="h-3.5 w-3.5"><use href="#i-plus"/></svg>@L.T("Add", "إضافة")</a>
                }
            </div>
            <div class="table-wrap">
                <table class="table-base">
                    <thead><tr><th>@L.T("Course", "الدورة")</th><th>@L.T("Section", "الشعبة")</th><th>@L.T("Fee", "الرسوم")</th><th>@L.T("Date", "التاريخ")</th><th>@L.T("Status", "الحالة")</th></tr></thead>
                    <tbody>
                    @if (Model.Enrollments.Count == 0)
                    {
                        <tr><td colspan="5"><div class="empty !py-8">@L.T("No enrollments yet.", "لا توجد اشتراكات بعد.")</div></td></tr>
                    }
                    @foreach (var e in Model.Enrollments.OrderByDescending(x => x.EnrollmentDate))
                    {
                        <tr>
                            <td>
                                <p class="font-semibold text-ink-900">@L.Pick(e.Course.NameAr, e.Course.NameEn)</p>
                                <p class="text-[11px] text-ink-500">@L.Pick(e.Course.Subject.NameAr, e.Course.Subject.NameEn)</p>
                            </td>
                            <td class="text-xs text-ink-500">@(e.Section?.Name ?? "—")</td>
                            <td class="font-semibold">@L.Money(e.NetFee)</td>
                            <td class="text-xs text-ink-500">@L.DateShort(e.EnrollmentDate)</td>
                            <td>
                                <span class="badge @(e.Status == EnrollmentStatus.Active ? "badge-green" : e.Status == EnrollmentStatus.Completed ? "badge-blue" : "badge-gray")">@L.E(e.Status)</span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h2 class="section-title">@L.T("Dues", "الأقساط")</h2><a asp-controller="Dues" asp-action="Index" asp-route-studentId="@Model.Id" class="text-xs link">@L.T("All dues", "كل الأقساط")</a></div>
            <div class="table-wrap">
                <table class="table-base">
                    <thead><tr><th>@L.T("Description", "البيان")</th><th>@L.T("Amount", "المبلغ")</th><th>@L.T("Paid", "المدفوع")</th><th>@L.T("Due date", "الاستحقاق")</th><th>@L.T("Status", "الحالة")</th></tr></thead>
                    <tbody>
                    @if (Model.Dues.Count == 0)
                    {
                        <tr><td colspan="5"><div class="empty !py-8">@L.T("No dues recorded.", "لا توجد أقساط مسجلة.")</div></td></tr>
                    }
                    @foreach (var d in Model.Dues.OrderBy(x => x.DueDate))
                    {
                        <tr>
                            <td class="font-semibold text-ink-900">@d.Description</td>
                            <td>@L.Money(d.Amount)</td>
                            <td class="@(d.Remaining > 0 ? "text-amber-700" : "text-emerald-700") font-semibold">@L.Money(d.PaidAmount)</td>
                            <td class="text-xs @(d.DueDate < DateTime.Today && d.Remaining > 0 ? "font-bold text-red-600" : "text-ink-500")">@L.DateShort(d.DueDate)</td>
                            <td><span class="badge @(d.Status == DueStatus.Paid ? "badge-green" : d.Status == DueStatus.Partial ? "badge-amber" : d.Status == DueStatus.Waived ? "badge-gray" : "badge-red")">@L.E(d.Status)</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="grid gap-5 xl:grid-cols-2">
            <div class="card">
                <div class="card-header"><h2 class="section-title">@L.T("Recent payments", "أحدث المدفوعات")</h2><a asp-controller="Payments" asp-action="Index" asp-route-studentId="@Model.Id" class="text-xs link">@L.T("All", "الكل")</a></div>
                <div class="divide-y divide-sand-200">
                    @if (Model.Payments.Count == 0)
                    {
                        <div class="empty !py-8">@L.T("No payments yet.", "لا توجد مدفوعات بعد.")</div>
                    }
                    @foreach (var p in Model.Payments.OrderByDescending(x => x.Date).Take(5))
                    {
                        <a asp-controller="Payments" asp-action="Receipt" asp-route-id="@p.Id" class="flex items-center justify-between gap-3 px-5 py-3 hover:bg-brand-50/50">
                            <div class="min-w-0">
                                <p class="truncate text-xs font-bold text-ink-900">@p.ReceiptNo</p>
                                <p class="text-[11px] text-ink-500">@L.DateShort(p.Date) · @L.E(p.Method)</p>
                            </div>
                            <span class="font-bold text-emerald-700">@L.Money(p.Amount)</span>
                        </a>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h2 class="section-title">@L.T("Latest attendance", "أحدث الحضور")</h2><a asp-controller="Attendance" asp-action="Index" class="text-xs link">@L.T("Register", "السجل")</a></div>
                <div class="divide-y divide-sand-200">
                    @if (attendance.Count == 0)
                    {
                        <div class="empty !py-8">@L.T("No attendance records yet.", "لا توجد سجلات حضور بعد.")</div>
                    }
                    @foreach (var a in attendance)
                    {
                        var tone = a.Status switch
                        {
                            AttendanceStatus.Present => "badge-green",
                            AttendanceStatus.Late => "badge-amber",
                            AttendanceStatus.Excused => "badge-blue",
                            _ => "badge-red"
                        };
                        <div class="flex items-center justify-between gap-3 px-5 py-2.5">
                            <div class="min-w-0">
                                <p class="truncate text-xs font-semibold text-ink-900">@L.Pick(a.Course.NameAr, a.Course.NameEn)</p>
                                <p class="text-[11px] text-ink-500">@L.DateShort(a.Date) · @a.Section.Name</p>
                            </div>
                            <span class="badge @tone">@L.E(a.Status)</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h2 class="section-title">@L.T("Exam results", "نتائج الامتحانات")</h2><a asp-controller="Exams" asp-action="Index" class="text-xs link">@L.T("Exams", "الامتحانات")</a></div>
            <div class="table-wrap">
                <table class="table-base">
                    <thead><tr><th>@L.T("Exam", "الامتحان")</th><th>@L.T("Course", "الدورة")</th><th>@L.T("Mark", "الدرجة")</th><th>@L.T("Result", "النتيجة")</th><th>@L.T("Date", "التاريخ")</th></tr></thead>
                    <tbody>
                    @if (results.Count == 0)
                    {
                        <tr><td colspan="5"><div class="empty !py-8">@L.T("No results published yet.", "لا توجد نتائج منشورة بعد.")</div></td></tr>
                    }
                    @foreach (var r in results)
                    {
                        var passed = r.Mark >= r.Exam.PassMark;
                        <tr>
                            <td class="font-semibold text-ink-900">@L.Pick(r.Exam.NameAr, r.Exam.NameEn)</td>
                            <td class="text-xs text-ink-500">@L.Pick(r.Exam.Course.NameAr, r.Exam.Course.NameEn)</td>
                            <td class="font-bold">@r.Mark.ToString("0.#") / @r.Exam.MaxMark</td>
                            <td><span class="badge @(passed ? "badge-green" : "badge-red")">@(passed ? L.T("Passed", "ناجح") : L.T("Failed", "راسب"))</span></td>
                            <td class="text-xs text-ink-500">@L.DateShort(r.Exam.Date)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

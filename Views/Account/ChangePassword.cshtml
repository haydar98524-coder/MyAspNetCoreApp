@model ChangePasswordViewModel
@{
    ViewData["Title"] = L.T("Change password", "تغيير كلمة المرور");
}
<div class="page-head">
    <div>
        <h1 class="page-title">@L.T("Change password", "تغيير كلمة المرور")</h1>
        <p class="page-sub">@L.T("Choose a strong password with at least 8 characters, an uppercase letter and a symbol.", "اختر كلمة مرور قوية من 8 أحرف على الأقل تتضمن حرفاً كبيراً ورمزاً.")</p>
    </div>
    <a asp-action="Profile" class="btn btn-outline"><svg class="h-4 w-4 flip-x"><use href="#i-arrow-left"/></svg>@L.T("Back to profile", "العودة للملف")</a>
</div>

<div class="max-w-xl">
    <form asp-action="ChangePassword" method="post" class="card card-pad space-y-5">
        <div asp-validation-summary="ModelOnly" class="alert alert-error empty:hidden"></div>
        <div>
            <label asp-for="CurrentPassword" class="label">@L.T("Current password", "كلمة المرور الحالية")</label>
            <input asp-for="CurrentPassword" type="password" class="input" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>
        <div>
            <label asp-for="NewPassword" class="label">@L.T("New password", "كلمة المرور الجديدة")</label>
            <input asp-for="NewPassword" type="password" class="input" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="label">@L.T("Confirm new password", "تأكيد كلمة المرور الجديدة")</label>
            <input asp-for="ConfirmPassword" type="password" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <div class="flex justify-end gap-2 border-t border-sand-200 pt-5">
            <a asp-action="Profile" class="btn btn-outline">@L.T("Cancel", "إلغاء")</a>
            <button class="btn btn-primary"><svg class="h-4 w-4"><use href="#i-key"/></svg>@L.T("Update password", "تحديث كلمة المرور")</button>
        </div>
    </form>
</div>

@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L.T("Sign in", "تسجيل الدخول");
    var demos = new[]
    {
        new { Role = L.T("Administrator", "مدير النظام"), Email = "admin@kirkuk.edu.iq", Password = "Admin@12345" },
        new { Role = L.T("Manager", "مدير المعهد"), Email = "manager@kirkuk.edu.iq", Password = "Manager@12345" },
        new { Role = L.T("Accountant", "المحاسب"), Email = "accountant@kirkuk.edu.iq", Password = "Accountant@12345" },
        new { Role = L.T("Registrar", "مسؤول التسجيل"), Email = "registrar@kirkuk.edu.iq", Password = "Registrar@12345" },
        new { Role = L.T("HR", "الموارد البشرية"), Email = "hr@kirkuk.edu.iq", Password = "Hr@12345" },
        new { Role = L.T("Teacher", "مدرّس"), Email = "teacher@kirkuk.edu.iq", Password = "Teacher@12345" },
        new { Role = L.T("Parent", "ولي أمر"), Email = "parent@kirkuk.edu.iq", Password = "Parent@12345" },
        new { Role = L.T("Student", "طالب"), Email = "student@kirkuk.edu.iq", Password = "Student@12345" }
    };
}

<h2 class="text-2xl font-extrabold text-brand-950">@L.T("Welcome back", "أهلاً بعودتك")</h2>
<p class="mt-2 text-sm text-ink-500">@L.T("Sign in to your workspace to continue.", "سجّل الدخول إلى مساحتك للمتابعة.")</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-error mt-5">
        <svg class="mt-0.5 h-5 w-5 shrink-0"><use href="#i-alert"/></svg>
        <div asp-validation-summary="ModelOnly" class="space-y-1 text-sm"></div>
    </div>
}

<form asp-action="Login" method="post" class="mt-6 space-y-4">
    <input type="hidden" asp-for="ReturnUrl" />
    <div>
        <label asp-for="Email" class="label">@L.T("Email address", "البريد الإلكتروني")</label>
        <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 start-3 flex items-center text-ink-500"><svg class="h-4 w-4"><use href="#i-mail"/></svg></span>
            <input asp-for="Email" class="input !ps-9" placeholder="name@kirkuk.edu.iq" autocomplete="username" autofocus />
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div>
        <div class="mb-1.5 flex items-center justify-between">
            <label asp-for="Password" class="label !mb-0">@L.T("Password", "كلمة المرور")</label>
            <button type="button" class="text-[11px] font-semibold text-brand-700 hover:underline" data-toggle-password="Password">@L.T("Show / hide", "إظهار / إخفاء")</button>
        </div>
        <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 start-3 flex items-center text-ink-500"><svg class="h-4 w-4"><use href="#i-key"/></svg></span>
            <input asp-for="Password" type="password" class="input !ps-9" placeholder="••••••••" autocomplete="current-password" />
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <label class="flex items-center gap-2 text-sm text-ink-700">
        <input asp-for="RememberMe" class="checkbox" />
        @L.T("Keep me signed in on this device", "إبقائي مسجلاً على هذا الجهاز")
    </label>
    <button type="submit" class="btn btn-primary btn-lg w-full">
        <svg class="h-4 w-4"><use href="#i-login"/></svg>
        @L.T("Sign in", "تسجيل الدخول")
    </button>
</form>

<div class="mt-7 rounded-2xl border border-sand-200 bg-white p-4">
    <div class="flex items-center justify-between">
        <p class="text-xs font-bold text-brand-950">@L.T("Demo accounts", "حسابات تجريبية")</p>
        <span class="chip !py-0.5 !text-[10px]">@L.T("click to fill", "اضغط للتعبئة")</span>
    </div>
    <div class="mt-3 grid grid-cols-2 gap-2">
        @foreach (var demo in demos)
        {
            <button type="button" class="rounded-lg border border-sand-200 bg-sand-50 px-2.5 py-2 text-start transition hover:border-brand-300 hover:bg-brand-50"
                    data-fill-email="@demo.Email" data-fill-password="@demo.Password">
                <span class="block text-[11px] font-bold text-brand-900">@demo.Role</span>
                <span class="mt-0.5 block truncate text-[10px] text-ink-500" dir="ltr">@demo.Email</span>
            </button>
        }
    </div>
    <p class="mt-3 text-[10px] leading-4 text-ink-500">@L.T("Demo passwords follow the pattern Role@12345. Change all demo passwords before production use.", "كلمات مرور الحسابات التجريبية بصيغة Role@12345. يُرجى تغييرها قبل التشغيل الفعلي.")</p>
</div>

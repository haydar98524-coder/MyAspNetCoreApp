@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L.T("Access denied", "لا تملك صلاحية");
}
<div class="card card-pad text-center">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-red-50 text-red-600">
        <svg class="h-7 w-7"><use href="#i-shield"/></svg>
    </span>
    <h2 class="mt-4 text-xl font-extrabold text-brand-950">@L.T("Access denied", "لا تملك صلاحية الوصول")</h2>
    <p class="mt-2 text-sm leading-6 text-ink-500">@L.T("Your account does not have permission to open this page. If you believe this is a mistake, contact the system administrator.", "حسابك لا يملك صلاحية فتح هذه الصفحة. إذا كنت تعتقد أن هذا خطأ، تواصل مع مدير النظام.")</p>
    <div class="mt-6 flex justify-center gap-2">
        <a asp-controller="Home" asp-action="Dashboard" class="btn btn-primary">@L.T("Back to dashboard", "العودة إلى لوحة التحكم")</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline">@L.T("Website", "الموقع")</a>
    </div>
</div>

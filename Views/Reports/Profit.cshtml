@model ProfitReportViewModel
@{
    ViewData["Title"] = L.T("Profit analysis", "تحليل الربح");
    var groups = new[] { "course", "teacher", "subject", "room" };
    var groupLabels = new Dictionary<string, string>
    {
        ["course"] = L.T("By course", "حسب الدورة"),
        ["teacher"] = L.T("By teacher", "حسب المدرّس"),
        ["subject"] = L.T("By subject", "حسب المادة"),
        ["room"] = L.T("By room", "حسب القاعة")
    };
    var totalMargin = Model.TotalRevenue == 0 ? 0 : Math.Round(Model.TotalProfit / Model.TotalRevenue * 100, 1);
}
<div class="page-head">
    <div>
        <div class="mb-1 flex items-center gap-2 text-xs text-ink-500">
            <a asp-action="Index" class="hover:text-brand-700">@L.T("Reports", "التقارير")</a>
            <svg class="h-3 w-3 flip-x"><use href="#i-chevron-down"/></svg>
            <span>@L.T("Profit analysis", "تحليل الربح")</span>
        </div>
        <h1 class="page-title">@L.T("Profit analysis", "تحليل الربح")</h1>
        <p class="page-sub">@L.Date(Model.From) — @L.Date(Model.To) · @groupLabels[Model.GroupBy]</p>
    </div>
    <div class="flex gap-2 no-print">
        <a asp-action="Index" class="btn btn-outline btn-sm">@L.T("Back", "رجوع")</a>
        <button type="button" class="btn btn-primary btn-sm" onclick="window.print()"><svg class="h-4 w-4"><use href="#i-printer"/></svg>@L.T("Print", "طباعة")</button>
    </div>
</div>

<div class="card card-pad !py-4 no-print">
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="flex flex-wrap gap-2">
            @foreach (var g in groups)
            {
                <a asp-action="Profit" asp-route-groupBy="@g" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
                   class="chip @(Model.GroupBy == g ? "!bg-brand-800 !text-white !ring-brand-800" : "")">@groupLabels[g]</a>
            }
        </div>
        <form method="get" class="flex flex-wrap items-end gap-2">
            <input type="hidden" name="groupBy" value="@Model.GroupBy" />
            <div>
                <label class="label">@L.T("From", "من")</label>
                <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="input !py-2" />
            </div>
            <div>
                <label class="label">@L.T("To", "إلى")</label>
                <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="input !py-2" />
            </div>
            <button class="btn btn-primary btn-sm">@L.T("Apply", "تطبيق")</button>
        </form>
    </div>
</div>

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5 mt-4">
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Revenue", "الإيراد")</p><p class="kpi mt-1 text-brand-900">@L.Money(Model.TotalRevenue)</p></div>
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Teacher shares", "حصص المدرسين")</p><p class="kpi mt-1 text-amber-700">@L.Money(Model.TotalTeacherCost)</p></div>
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Direct expenses", "مصروفات مباشرة")</p><p class="kpi mt-1 text-red-600">@L.Money(Model.TotalExpenses)</p></div>
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Profit", "الربح")</p><p class="kpi mt-1 @(Model.TotalProfit >= 0 ? "text-emerald-700" : "text-red-600")">@L.Money((long)Model.TotalProfit)</p></div>
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Margin", "الهامش")</p><p class="kpi mt-1">@totalMargin.ToString("0.#")%</p></div>
</div>

<div class="card mt-4 overflow-hidden">
    <div class="card-header">
        <div>
            <h2 class="section-title">@L.T("Contribution by group", "المساهمة حسب المجموعة")</h2>
            <p class="text-[11px] text-ink-500">@L.T("Revenue from tuition payments against teacher course shares and course-linked expenses.", "الإيراد من دفعات الرسوم مقابل حصص المدرسين والمصروفات المرتبطة بالدورات.")</p>
        </div>
    </div>
    <div class="table-wrap">
        <table class="table-base min-w-[900px]">
            <thead>
                <tr>
                    <th>@L.T("Group", "المجموعة")</th>
                    <th>@L.T("Revenue", "الإيراد")</th>
                    <th>@L.T("Teacher cost", "كلفة المدرّس")</th>
                    <th>@L.T("Expenses", "المصروفات")</th>
                    <th>@L.T("Profit", "الربح")</th>
                    <th class="w-44">@L.T("Margin", "الهامش")</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Lines.Count == 0)
            {
                <tr><td colspan="6"><div class="empty">@L.T("No financial activity in this period.", "لا يوجد نشاط مالي في هذه الفترة.")</div></td></tr>
            }
            @foreach (var line in Model.Lines)
            {
                var width = Math.Clamp((int)line.Margin, 0, 100);
                <tr>
                    <td>
                        <p class="font-semibold text-ink-900">@line.Name</p>
                        <p class="text-[11px] text-ink-500">@line.Meta</p>
                    </td>
                    <td class="text-sm">@L.Money(line.Revenue)</td>
                    <td class="text-sm text-amber-700">@L.Money(line.TeacherCost)</td>
                    <td class="text-sm text-red-600">@L.Money(line.Expenses)</td>
                    <td class="text-sm font-bold @(line.Profit >= 0 ? "text-emerald-700" : "text-red-600")">@L.Money((long)line.Profit)</td>
                    <td>
                        <div class="flex items-center gap-2">
                            <div class="progress w-24"><span class="@(line.Margin < 0 ? "!bg-red-500" : "")" style="width:@(Math.Max(2, width))%"></span></div>
                            <span class="text-xs font-semibold @(line.Margin >= 30 ? "text-emerald-700" : line.Margin >= 0 ? "text-amber-600" : "text-red-600")">@line.Margin.ToString("0.#")%</span>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="bg-sand-50 font-bold">
                    <td>@L.T("Total", "الإجمالي")</td>
                    <td>@L.Money(Model.TotalRevenue)</td>
                    <td class="text-amber-700">@L.Money(Model.TotalTeacherCost)</td>
                    <td class="text-red-600">@L.Money(Model.TotalExpenses)</td>
                    <td class="@(Model.TotalProfit >= 0 ? "text-emerald-700" : "text-red-600")">@L.Money((long)Model.TotalProfit)</td>
                    <td>@totalMargin.ToString("0.#")%</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<p class="mt-3 text-[10px] text-ink-400">@L.T("Rooms are allocated tuition revenue and costs in proportion to scheduled weekly minutes. Unassigned amounts have no linked course.", "توزع القاعات الإيراد والكلفة بنسبة دقائق الجدول الأسبوعي. المبالغ غير المحددة لا ترتبط بدورة.")</p>

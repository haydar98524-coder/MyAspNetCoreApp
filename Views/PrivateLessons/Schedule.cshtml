@model ScheduleLessonViewModel
@{
    ViewData["Title"] = L.T("Schedule a private lesson", "جدولة درس خصوصي");
    var request = ViewBag.Request as PrivateLessonRequest;
    var sharePercent = (await Db.Settings.AsNoTracking().FirstOrDefaultAsync(s => s.Id == 1))?.PrivateLessonTeacherShare ?? 60m;
}
<div class="page-head">
    <div>
        <h1 class="page-title">@L.T("Schedule a private lesson", "جدولة درس خصوصي")</h1>
        <p class="page-sub">
            @if (request is not null)
            {
                <span>@request.GuardianName · @L.Pick(request.Subject.NameAr, request.Subject.NameEn) · @L.Pick(request.Grade.NameAr, request.Grade.NameEn)</span>
            }
            else
            {
                <span>@L.T("Set the date, time and fee for the lesson.", "حدّد تاريخ ووقت وأجر الدرس.")</span>
            }
        </p>
    </div>
    @if (request is not null)
    {
        <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-outline btn-sm"><svg class="h-4 w-4 flip-x"><use href="#i-arrow-left"/></svg>@L.T("Back to request", "العودة للطلب")</a>
    }
</div>

<form asp-action="Schedule" method="post" class="grid gap-4 lg:grid-cols-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RequestId" />
    <div class="card card-pad lg:col-span-2">
        <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4 @(ViewData.ModelState.ErrorCount == 0 ? "hidden" : "")"></div>
        <h2 class="section-title">@L.T("Lesson details", "تفاصيل الدرس")</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
                <label class="label">@L.T("Date", "التاريخ")</label>
                <input asp-for="Date" type="date" class="input" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Date" class="field-error"></span>
            </div>
            <div>
                <label class="label">@L.T("Start time", "وقت البداية")</label>
                <input asp-for="StartTime" type="time" class="input" id="startTime" />
                <span asp-validation-for="StartTime" class="field-error"></span>
            </div>
            <div>
                <label class="label">@L.T("Duration (minutes)", "المدة (دقيقة)")</label>
                <input asp-for="DurationMinutes" type="number" min="30" max="240" step="15" class="input" id="duration" />
                <span asp-validation-for="DurationMinutes" class="field-error"></span>
            </div>
            <div>
                <label class="label">@L.T("Lesson fee (IQD)", "أجر الدرس (د.ع)")</label>
                <input asp-for="Fee" type="number" min="0" step="1000" class="input text-end tabular-nums" id="fee" />
                <span asp-validation-for="Fee" class="field-error"></span>
            </div>
            <div class="sm:col-span-2">
                <label class="label">@L.T("Notes for the teacher", "ملاحظات للمدرّس")</label>
                <textarea asp-for="Notes" rows="3" class="input" placeholder="@L.T("Topic, materials or access instructions", "الموضوع أو المواد أو تعليمات الوصول")"></textarea>
            </div>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
            <button class="btn btn-primary"><svg class="h-4 w-4"><use href="#i-calendar"/></svg>@L.T("Schedule lesson", "جدولة الدرس")</button>
            @if (request is not null)
            {
                <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-outline">@L.T("Cancel", "إلغاء")</a>
            }
        </div>
    </div>

    <div class="flex flex-col gap-4">
        @if (request is not null)
        {
            <div class="card card-pad">
                <h2 class="section-title">@L.T("Request summary", "ملخص الطلب")</h2>
                <dl class="mt-3 space-y-2 text-xs">
                    <div class="flex justify-between"><dt class="text-ink-500">@L.T("Subject", "المادة")</dt><dd class="font-semibold">@L.Pick(request.Subject.NameAr, request.Subject.NameEn)</dd></div>
                    <div class="flex justify-between"><dt class="text-ink-500">@L.T("Grade", "الصف")</dt><dd class="font-semibold">@L.Pick(request.Grade.NameAr, request.Grade.NameEn)</dd></div>
                    <div class="flex justify-between"><dt class="text-ink-500">@L.T("Mode", "النمط")</dt><dd class="font-semibold">@L.E(request.Mode)</dd></div>
                    <div class="flex justify-between"><dt class="text-ink-500">@L.T("Area", "المنطقة")</dt><dd class="font-semibold">@request.Area</dd></div>
                    <div class="flex justify-between"><dt class="text-ink-500">@L.T("Teacher", "المدرّس")</dt><dd class="font-semibold">@(request.MatchedTeacher is not null ? L.Pick(request.MatchedTeacher.FullNameAr, request.MatchedTeacher.FullNameEn) : "—")</dd></div>
                </dl>
            </div>
        }
        <div class="card card-pad">
            <h2 class="section-title">@L.T("Fee split", "توزيع الأجر")</h2>
            <dl class="mt-3 space-y-2 text-xs">
                <div class="flex justify-between"><dt class="text-ink-500">@L.T("Lesson fee", "أجر الدرس")</dt><dd id="previewFee" class="font-bold text-brand-900">—</dd></div>
                <div class="flex justify-between"><dt class="text-ink-500">@L.T("Teacher share", "حصة المدرّس")</dt><dd id="previewShare" class="font-semibold text-violet-700">—</dd></div>
                <div class="flex justify-between"><dt class="text-ink-500">@L.T("Institute share", "حصة المعهد")</dt><dd id="previewInstitute" class="font-semibold text-emerald-700">—</dd></div>
                <div class="flex justify-between"><dt class="text-ink-500">@L.T("Ends at", "ينتهي")</dt><dd id="previewEnd" class="font-semibold" dir="ltr">—</dd></div>
            </dl>
            <p class="mt-3 rounded-xl bg-sand-50 p-3 text-[11px] text-ink-500">
                @L.T("The teacher share is accrued automatically to payables when the fee is collected.", "تُحتسب حصة المدرّس تلقائياً ضمن المستحقات عند قبض الأجر.")
                <span class="mt-1 block font-semibold text-ink-700">@L.Percent(sharePercent)</span>
            </p>
        </div>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        var sharePercent = Number('@sharePercent');
        var start = document.getElementById('startTime');
        var duration = document.getElementById('duration');
        var fee = document.getElementById('fee');
        var endView = document.getElementById('previewEnd');
        var feeView = document.getElementById('previewFee');
        var shareView = document.getElementById('previewShare');
        var instituteView = document.getElementById('previewInstitute');

        function recalc() {
            var amount = Number(fee.value || 0);
            var share = Math.round(amount * sharePercent / 100);
            feeView.textContent = amount.toLocaleString() + ' @L.T("IQD", "د.ع")';
            shareView.textContent = share.toLocaleString() + ' @L.T("IQD", "د.ع")';
            instituteView.textContent = (amount - share).toLocaleString() + ' @L.T("IQD", "د.ع")';

            if (start.value) {
                var parts = start.value.split(':');
                var total = Number(parts[0]) * 60 + Number(parts[1]) + Number(duration.value || 0);
                total = ((total % 1440) + 1440) % 1440;
                var hh = String(Math.floor(total / 60)).padStart(2, '0');
                var mm = String(total % 60).padStart(2, '0');
                endView.textContent = hh + ':' + mm;
            } else {
                endView.textContent = '—';
            }
        }
        [start, duration, fee].forEach(function (el) { el.addEventListener('input', recalc); });
        recalc();
    })();
</script>
}

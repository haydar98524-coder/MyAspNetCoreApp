@{
    Layout = "_PublicLayout";
    var code = ViewData["Code"] as int? ?? 404;
    var title = code == 404 ? L.T("Page not found", "الصفحة غير موجودة") : L.T("Something went wrong", "حدث خطأ غير متوقع");
    var message = code == 404
        ? L.T("The page you requested does not exist or has been moved.", "الصفحة التي طلبتها غير موجودة أو تم نقلها.")
        : L.T("We could not complete your request. Please try again or return to the homepage.", "تعذر إكمال طلبك. حاول مرة أخرى أو عد إلى الصفحة الرئيسية.");
}
<section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-20 text-center sm:px-6 lg:px-8">
    <p class="text-[88px] font-extrabold leading-none text-brand-200">@code</p>
    <h1 class="mt-3 text-2xl font-extrabold text-brand-950">@title</h1>
    <p class="mt-3 max-w-md text-sm leading-7 text-ink-500">@message</p>
    <div class="mt-7 flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><svg class="h-4 w-4"><use href="#i-home"/></svg>@L.T("Homepage", "الرئيسية")</a>
        <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline">@L.T("My workspace", "مساحتي")</a>
    </div>
</section>

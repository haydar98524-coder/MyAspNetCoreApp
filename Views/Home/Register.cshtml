@model PublicRegistrationViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = L.T("Online registration", "التسجيل الإلكتروني");
    var grades = ViewBag.Grades as List<Grade> ?? new List<Grade>();
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
    var settings = Model is null ? new InstituteSettings() : null;
}
<section class="relative overflow-hidden bg-brand-950 py-12">
    <div class="pointer-events-none absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 26px 26px;"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <span class="chip !border-white/20 !bg-white/10 !text-gold-300">@L.T("Admissions", "القبول والتسجيل")</span>
        <h1 class="mt-3 text-3xl font-extrabold text-white sm:text-4xl">@L.T("Online registration request", "استمارة التسجيل الإلكتروني")</h1>
        <p class="mt-2 max-w-2xl text-sm leading-7 text-brand-100/65">@L.T("Fill in the student and guardian details. The registrar will review the request, confirm the course or section, and contact you using the phone number provided.", "املأ بيانات الطالب وولي الأمر. سيراجع مسؤول التسجيل الطلب، ويؤكد الدورة أو الشعبة، ثم يتواصل معكم عبر رقم الهاتف المذكور.")</p>
    </div>
</section>

<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[1fr_320px]">
        <form asp-controller="Home" asp-action="Register" method="post" class="card card-pad space-y-8">
            <div asp-validation-summary="ModelOnly" class="alert alert-error empty:hidden"></div>

            <section>
                <div class="flex items-center gap-2">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-700 text-xs font-bold text-white">1</span>
                    <h2 class="text-base font-bold">@L.T("Student details", "بيانات الطالب")</h2>
                </div>
                <div class="form-grid mt-4">
                    <div class="sm:col-span-2">
                        <label asp-for="StudentNameAr" class="label">@L.T("Student full name (Arabic)", "اسم الطالب الكامل (بالعربية)") <span class="text-red-500">*</span></label>
                        <input asp-for="StudentNameAr" class="input" placeholder="@L.T("First, father, grandfather and family name", "الاسم الأول واسم الأب والجد والعائلة")" />
                        <span asp-validation-for="StudentNameAr" class="field-error"></span>
                    </div>
                    <div class="sm:col-span-2">
                        <label asp-for="StudentNameEn" class="label">@L.T("Student name (English, optional)", "اسم الطالب (بالإنجليزية، اختياري)")</label>
                        <input asp-for="StudentNameEn" class="input" dir="ltr" placeholder="Ammar Abdulrahman Ali" />
                    </div>
                    <div>
                        <label asp-for="Gender" class="label">@L.T("Gender", "الجنس")</label>
                        <select asp-for="Gender" class="select">
                            <option value="@Gender.Male">@L.E(Gender.Male)</option>
                            <option value="@Gender.Female">@L.E(Gender.Female)</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="BirthDate" class="label">@L.T("Date of birth", "تاريخ الميلاد")</label>
                        <input asp-for="BirthDate" type="date" class="input" asp-format="{0:yyyy-MM-dd}" />
                        <span asp-validation-for="BirthDate" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="GradeId" class="label">@L.T("Grade", "الصف الدراسي") <span class="text-red-500">*</span></label>
                        <select asp-for="GradeId" class="select" id="GradeId">
                            <option value="0">@L.T("Choose the grade", "اختر الصف")</option>
                            @foreach (var group in grades.GroupBy(g => g.Stage).OrderBy(g => g.Key.Order))
                            {
                                <optgroup label="@L.Pick(group.Key.NameAr, group.Key.NameEn)">
                                    @foreach (var grade in group.OrderBy(g => g.Level))
                                    {
                                        <option value="@grade.Id">@L.Pick(grade.NameAr, grade.NameEn)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <span asp-validation-for="GradeId" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="SchoolName" class="label">@L.T("Current school", "المدرسة الحالية") <span class="text-red-500">*</span></label>
                        <input asp-for="SchoolName" class="input" placeholder="@L.T("School name", "اسم المدرسة")" />
                        <span asp-validation-for="SchoolName" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Area" class="label">@L.T("Area / neighbourhood", "المنطقة / الحي") <span class="text-red-500">*</span></label>
                        <input asp-for="Area" class="input" placeholder="@L.T("Al-Musalla", "المصلى")" />
                        <span asp-validation-for="Area" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="StudentPhone" class="label">@L.T("Student phone (optional)", "هاتف الطالب (اختياري)")</label>
                        <input asp-for="StudentPhone" class="input" dir="ltr" placeholder="0770 000 0000" />
                    </div>
                    <div class="sm:col-span-2">
                        <label asp-for="Address" class="label">@L.T("Full address", "العنوان الكامل") <span class="text-red-500">*</span></label>
                        <input asp-for="Address" class="input" placeholder="@L.T("Street, landmark, house number", "الشارع، نقطة دالة، رقم المنزل")" />
                        <span asp-validation-for="Address" class="field-error"></span>
                    </div>
                </div>
            </section>

            <div class="divider"></div>

            <section>
                <div class="flex items-center gap-2">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-700 text-xs font-bold text-white">2</span>
                    <h2 class="text-base font-bold">@L.T("Guardian details", "بيانات ولي الأمر")</h2>
                </div>
                <div class="form-grid mt-4">
                    <div class="sm:col-span-2">
                        <label asp-for="GuardianName" class="label">@L.T("Guardian full name", "اسم ولي الأمر الكامل") <span class="text-red-500">*</span></label>
                        <input asp-for="GuardianName" class="input" />
                        <span asp-validation-for="GuardianName" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="GuardianPhone" class="label">@L.T("Guardian phone", "هاتف ولي الأمر") <span class="text-red-500">*</span></label>
                        <input asp-for="GuardianPhone" class="input" dir="ltr" placeholder="0770 000 0000" />
                        <span asp-validation-for="GuardianPhone" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="GuardianEmail" class="label">@L.T("Email (optional)", "البريد الإلكتروني (اختياري)")</label>
                        <input asp-for="GuardianEmail" class="input" dir="ltr" placeholder="name@example.com" />
                        <span asp-validation-for="GuardianEmail" class="field-error"></span>
                    </div>
                </div>
            </section>

            <div class="divider"></div>

            <section>
                <div class="flex items-center gap-2">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-700 text-xs font-bold text-white">3</span>
                    <h2 class="text-base font-bold">@L.T("Course (optional)", "الدورة (اختياري)")</h2>
                </div>
                <p class="mt-1 text-xs text-ink-500">@L.T("You can leave this blank; the registrar will advise on the appropriate course after reviewing the grade.", "يمكنك ترك هذا الحقل فارغاً؛ سيقترح مسؤول التسجيل الدورة المناسبة بعد مراجعة الصف.")</p>
                <div class="form-grid mt-4">
                    <div class="sm:col-span-2">
                        <label asp-for="CourseId" class="label">@L.T("Preferred course", "الدورة المفضلة")</label>
                        <select asp-for="CourseId" class="select" id="CourseId">
                            <option value="">@L.T("No course selected — advise me", "بدون اختيار — أرشدوني")</option>
                            @foreach (var course in courses)
                            {
                                var seats = Math.Max(0, course.Capacity - course.Enrollments.Count(e => e.Status == EnrollmentStatus.Active));
                                <option value="@course.Id" data-grade="@course.GradeId" disabled="@(seats == 0)">
                                    @L.Pick(course.Grade.NameAr, course.Grade.NameEn) — @L.Pick(course.NameAr, course.NameEn) · @L.Pick(course.Teacher.FullNameAr, course.Teacher.FullNameEn) @(seats == 0 ? L.T(" (full)", " (مكتمل)") : "")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CourseId" class="field-error"></span>
                    </div>
                    <div class="sm:col-span-2">
                        <label asp-for="Notes" class="label">@L.T("Additional notes", "ملاحظات إضافية")</label>
                        <textarea asp-for="Notes" class="textarea" placeholder="@L.T("Previous courses, special needs, preferred times…", "دورات سابقة، احتياجات خاصة، أوقات مفضلة…")"></textarea>
                    </div>
                </div>
            </section>

            <label class="flex items-start gap-2.5 rounded-xl border border-sand-200 bg-sand-50 p-4 text-xs leading-6 text-ink-700">
                <input asp-for="Consent" class="checkbox mt-0.5" />
                <span>@L.T("I confirm that the information above is correct and consent to the institute contacting me about registration and lessons.", "أؤكد صحة المعلومات أعلاه وأوافق على تواصل المعهد معي بخصوص التسجيل والدروس.")</span>
            </label>
            <span asp-validation-for="Consent" class="field-error"></span>

            <div class="flex flex-wrap justify-end gap-2 border-t border-sand-200 pt-5">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline">@L.T("Cancel", "إلغاء")</a>
                <button class="btn btn-primary btn-lg"><svg class="h-4 w-4"><use href="#i-check"/></svg>@L.T("Submit registration", "إرسال طلب التسجيل")</button>
            </div>
        </form>

        <aside class="space-y-4">
            <div class="card card-pad">
                <h3 class="text-sm font-bold">@L.T("How it works", "كيف تتم العملية؟")</h3>
                <ol class="mt-4 space-y-4">
                    <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-[11px] font-bold text-brand-700">1</span><p class="text-xs leading-5 text-ink-500">@L.T("Submit this form online.", "أرسل هذه الاستمارة إلكترونياً.")</p></li>
                    <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-[11px] font-bold text-brand-700">2</span><p class="text-xs leading-5 text-ink-500">@L.T("The registrar confirms the grade, course and section by phone.", "يؤكد مسؤول التسجيل الصف والدورة والشعبة هاتفياً.")</p></li>
                    <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-[11px] font-bold text-brand-700">3</span><p class="text-xs leading-5 text-ink-500">@L.T("Visit the institute to complete the file and pay the first instalment.", "زيارة المعهد لاستكمال الملف ودفع القسط الأول.")</p></li>
                    <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-[11px] font-bold text-brand-700">4</span><p class="text-xs leading-5 text-ink-500">@L.T("Receive the student number, ID card and portal access.", "استلام رقم الطالب وبطاقة الهوية والوصول إلى البوابة.")</p></li>
                </ol>
            </div>
            <div class="card card-pad bg-brand-950 !border-brand-900 text-white">
                <h3 class="text-sm font-bold text-white">@L.T("Need help?", "تحتاج مساعدة؟")</h3>
                <p class="mt-2 text-xs leading-6 text-brand-100/65">@L.T("Call the registrar during working hours and we will complete the registration with you.", "اتصل بمسؤول التسجيل خلال أوقات الدوام وسنكمل التسجيل معك.")</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-gold btn-sm mt-3 w-full">@L.T("Back to homepage", "العودة للرئيسية")</a>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var grade = document.getElementById("GradeId");
            var course = document.getElementById("CourseId");
            if (!grade || !course) return;
            function filterCourses() {
                var gradeId = grade.value;
                Array.prototype.forEach.call(course.querySelectorAll("option[data-grade]"), function (option) {
                    var matches = !gradeId || gradeId === "0" || option.getAttribute("data-grade") === gradeId;
                    option.hidden = !matches;
                });
                var selected = course.options[course.selectedIndex];
                if (selected && selected.hidden) course.value = "";
            }
            grade.addEventListener("change", filterCourses);
            filterCourses();
        })();
    </script>
}

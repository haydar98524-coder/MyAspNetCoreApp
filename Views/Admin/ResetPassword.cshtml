@model AdminResetPasswordViewModel
@{
    ViewData["Title"] = L.T("Reset password", "إعادة تعيين كلمة المرور");
}
<div class="page-head">
    <div>
        <div class="mb-1 flex items-center gap-2 text-xs text-ink-500">
            <a asp-action="Users" class="hover:text-brand-700">@L.T("Users & roles", "المستخدمون والصلاحيات")</a>
            <svg class="h-3 w-3 flip-x"><use href="#i-chevron-down"/></svg>
            <span>@L.T("Reset password", "إعادة تعيين كلمة المرور")</span>
        </div>
        <h1 class="page-title">@L.T("Reset password", "إعادة تعيين كلمة المرور")</h1>
        <p class="page-sub">@Model.FullName · <span dir="ltr">@Model.Email</span></p>
    </div>
    <a asp-action="Users" class="btn btn-outline btn-sm">@L.T("Cancel", "إلغاء")</a>
</div>

<div class="grid max-w-3xl gap-5">
    <form method="post" asp-action="ResetPassword" class="card card-pad">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="FullName" />
        <input type="hidden" asp-for="Email" />
        <div asp-validation-summary="ModelOnly" class="alert alert-error @(ViewData.ModelState.IsValid ? "hidden" : "")"></div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="NewPassword" class="label">@L.T("New password", "كلمة المرور الجديدة") *</label>
                <input asp-for="NewPassword" type="password" class="input" dir="ltr" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="label">@L.T("Confirm password", "تأكيد كلمة المرور") *</label>
                <input asp-for="ConfirmPassword" type="password" class="input" dir="ltr" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>

        <div class="alert alert-warning mt-4">
            <svg class="mt-0.5 h-5 w-5 shrink-0"><use href="#i-alert"/></svg>
            <p>@L.T("The user's active sessions will be revoked and they must sign in again with the new password.", "ستُلغى جلسات المستخدم النشطة وعليه تسجيل الدخول من جديد بكلمة المرور الجديدة.")</p>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
            <button class="btn btn-primary"><svg class="h-5 w-5"><use href="#i-key"/></svg>@L.T("Set new password", "تعيين كلمة المرور")</button>
            <a asp-action="Users" class="btn btn-ghost">@L.T("Cancel", "إلغاء")</a>
        </div>
    </form>

    <div class="card card-pad !bg-brand-50">
        <p class="flex items-start gap-2 text-xs text-brand-800">
            <svg class="mt-0.5 h-4 w-4 shrink-0"><use href="#i-shield"/></svg>
            <span>@L.T("This action is recorded in the audit trail together with your administrator account and the time it was performed.", "يُسجل هذا الإجراء في سجل التدقيق مع حساب مدير النظام ووقت التنفيذ.")</span>
        </p>
    </div>
</div>

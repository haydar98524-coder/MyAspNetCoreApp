@model AdminBackupViewModel
@{
    ViewData["Title"] = L.T("Backup & API", "النسخ الاحتياطي والـ API");
    string Size(long bytes) => bytes >= 1_048_576
        ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:0.#} MB", bytes / 1_048_576d)
        : string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:0.#} KB", bytes / 1024d);
    var integrityOk = string.Equals(Model.Integrity, "ok", StringComparison.OrdinalIgnoreCase);
    var datasets = new (string Key, string TitleAr, string TitleEn, string DescAr, string DescEn, string Icon)[]
    {
        ("students", "الطلبة", "Students", "بيانات الطلبة وأولياء الأمور والصفوف.", "Student, guardian and grade records.", "#i-users"),
        ("payments", "الدفعات", "Payments", "سندات القبض مع الطالب وطريقة الدفع.", "Receipts with student and payment method.", "#i-receipt"),
        ("dues", "الذمم", "Dues", "الأقساط المتبقية والمستحقة.", "Outstanding and paid installments.", "#i-wallet"),
        ("ledger", "دفتر اليومية", "General ledger", "جميع القيود المحاسبية وأرصدتها.", "All journal lines with account codes.", "#i-book"),
        ("employees", "الموظفون", "Employees", "ملفات الموظفين والرواتب الأساسية.", "Employee profiles and base salaries.", "#i-briefcase"),
        ("payroll", "الرواتب", "Payroll", "مسير الرواتب الشهري لكل موظف.", "Monthly payroll runs per employee.", "#i-cash")
    };
}
<div class="page-head">
    <div>
        <h1 class="page-title">@L.T("Backup & API", "النسخ الاحتياطي والـ API")</h1>
        <p class="page-sub">@L.T("Database snapshots, integrity checks and read-only data exports.", "نسخ قاعدة البيانات وفحص السلامة وتصدير البيانات للقراءة فقط.")</p>
    </div>
    <a asp-action="Compliance" class="btn btn-outline btn-sm"><svg class="h-4 w-4"><use href="#i-shield"/></svg>@L.T("Compliance check", "فحص الامتثال")</a>
</div>

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Database size", "حجم قاعدة البيانات")</p><p class="kpi mt-1">@Size(Model.DatabaseBytes)</p></div>
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Student & payment records", "سجلات الطلبة والدفعات")</p><p class="kpi mt-1 text-brand-800">@L.Num(Model.Students + Model.Payments)</p></div>
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Journal entries", "القيود المحاسبية")</p><p class="kpi mt-1 text-emerald-700">@L.Num(Model.JournalEntries)</p></div>
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Last snapshot", "آخر نسخة")</p><p class="mt-1 text-sm font-bold text-brand-950">@(Model.LastBackupAt.HasValue ? L.DateTimeShort(Model.LastBackupAt.Value) : L.T("Never", "لم تُنشأ"))</p></div>
</div>

<div class="mt-5 grid items-start gap-5 lg:grid-cols-3">
    <div class="space-y-5 lg:col-span-2">
        <div class="card card-pad">
            <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h2 class="section-title">@L.T("Database snapshots", "نسخ قاعدة البيانات")</h2>
                    <p class="mt-1 text-xs text-ink-500">@L.T("A full COPY_ONLY backup (.bak) with checksums is taken by SQL Server while the system is running.", "يأخذ SQL Server نسخة كاملة (.bak) من نوع COPY_ONLY مع التحقق أثناء عمل النظام.")</p>
                </div>
                <form asp-action="CreateBackup" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-primary btn-sm"><svg class="h-4 w-4"><use href="#i-database"/></svg>@L.T("Create snapshot", "إنشاء نسخة")</button>
                </form>
            </div>
            <div class="table-wrap">
                <table class="table-base">
                    <thead>
                        <tr>
                            <th>@L.T("File", "الملف")</th>
                            <th>@L.T("Created", "وقت الإنشاء")</th>
                            <th>@L.T("Size", "الحجم")</th>
                            <th class="text-end">@L.T("Actions", "الإجراءات")</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Backups.Count == 0)
                    {
                        <tr><td colspan="4"><div class="empty">@L.T("No snapshots yet. Create the first one before making bulk changes.", "لا توجد نسخ بعد. أنشئ النسخة الأولى قبل إجراء تغييرات كبيرة.")</div></td></tr>
                    }
                    @foreach (var b in Model.Backups)
                    {
                        <tr>
                            <td class="text-xs font-semibold text-ink-800" dir="ltr">@b.Name</td>
                            <td class="text-xs text-ink-600">@L.DateTimeShort(b.CreatedAt)</td>
                            <td class="text-xs text-ink-600">@Size(b.Bytes)</td>
                            <td>
                                <div class="flex justify-end gap-1">
                                    <a asp-action="DownloadBackup" asp-route-name="@b.Name" class="icon-btn" title="@L.T("Download", "تنزيل")"><svg class="h-4 w-4"><use href="#i-download"/></svg></a>
                                    <form asp-action="DeleteBackup" asp-route-name="@b.Name" method="post" onsubmit="return confirm('@L.T("Delete this snapshot permanently?", "حذف هذه النسخة نهائياً؟")')">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-btn text-red-600" title="@L.T("Delete", "حذف")"><svg class="h-4 w-4"><use href="#i-ban"/></svg></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-[11px] text-ink-500">@L.T("The ten most recent snapshots are kept automatically. Download copies to external storage for long-term retention.", "يُحتفظ بأحدث عشر نسخ تلقائياً. نزّل النسخ إلى وسائط خارجية للحفظ طويل الأمد.")</p>
        </div>

        <div class="card card-pad">
            <h2 class="section-title mb-1">@L.T("Data exports & integration endpoints", "تصدير البيانات ونقاط التكامل")</h2>
            <p class="mb-4 text-xs text-ink-500">@L.T("Administrator-only JSON exports. Call them from scripts or a reporting tool with an authenticated session.", "تصدير JSON مخصص لمدير النظام. استدعها من السكربتات أو أدوات التقارير بجلسة موثقة.")</p>
            <div class="grid gap-3 sm:grid-cols-2">
                @foreach (var d in datasets)
                {
                    <div class="flex items-start gap-3 rounded-xl border border-sand-200 p-3">
                        <span class="stat-icon !h-9 !w-9 bg-brand-50 text-brand-700"><svg class="h-4 w-4"><use href="@d.Icon"/></svg></span>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-bold text-brand-950">@L.Pick(d.TitleAr, d.TitleEn)</p>
                            <p class="text-[11px] text-ink-500">@L.Pick(d.DescAr, d.DescEn)</p>
                            <p class="mt-1 truncate text-[10px] text-ink-400" dir="ltr">/Admin/Export?dataset=@d.Key</p>
                        </div>
                        <a asp-action="Export" asp-route-dataset="@d.Key" class="icon-btn shrink-0" title="@L.T("Download JSON", "تنزيل JSON")"><svg class="h-4 w-4"><use href="#i-download"/></svg></a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="space-y-5">
        <div class="card card-pad">
            <h2 class="section-title mb-4">@L.T("Database health", "سلامة قاعدة البيانات")</h2>
            <div class="space-y-3 text-xs">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-ink-500">@L.T("Integrity check", "فحص السلامة")</span>
                    <span class="badge @(integrityOk ? "badge-green" : "badge-red")">@(integrityOk ? L.T("Passed", "ناجح") : L.T("Review", "يحتاج مراجعة"))</span>
                </div>
                <div class="flex items-center justify-between gap-2">
                    <span class="text-ink-500">SQL Server</span>
                    <span class="font-semibold text-ink-800" dir="ltr">@Model.ServerVersion</span>
                </div>
                <div class="flex items-center justify-between gap-2">
                    <span class="text-ink-500">@L.T("Server / database", "الخادم / قاعدة البيانات")</span>
                    <span class="font-semibold text-ink-800" dir="ltr">@Model.ServerName / @Model.DatabaseName</span>
                </div>
                <div class="flex items-center justify-between gap-2">
                    <span class="text-ink-500">@L.T("Mapped tables", "الجداول المعينة")</span>
                    <span class="font-semibold text-ink-800">@L.Num(Model.Tables)</span>
                </div>
                <div class="flex items-center justify-between gap-2">
                    <span class="text-ink-500">@L.T("User accounts", "حسابات المستخدمين")</span>
                    <span class="font-semibold text-ink-800">@L.Num(Model.Users)</span>
                </div>
                <div class="border-t border-sand-200 pt-3">
                    <p class="text-[10px] font-bold uppercase text-ink-400">@L.T("Data file", "ملف البيانات")</p>
                    <p class="mt-1 break-all text-[10px] text-ink-500" dir="ltr">@Model.DatabasePath</p>
                </div>
            </div>
        </div>

        <div class="card card-pad">
            <h2 class="section-title mb-3">@L.T("Restore procedure", "إجراء الاستعادة")</h2>
            <ol class="list-decimal space-y-2 ps-4 text-xs text-ink-600">
                <li>@L.T("Stop the application so no one is writing to the database.", "أوقف التطبيق حتى لا تتم أي كتابة على قاعدة البيانات.")</li>
                <li>@L.T("In SQL Server Management Studio choose Restore Database, or run the command below with the chosen .bak file.", "في SQL Server Management Studio اختر Restore Database، أو نفّذ الأمر أدناه مع ملف ‎.bak المطلوب.")</li>
                <li>@L.T("Start the application and verify the compliance checks.", "شغّل التطبيق وتحقق من فحوص الامتثال.")</li>
            </ol>
            <pre class="mt-3 overflow-x-auto rounded-xl bg-ink-900 p-3 text-[10px] leading-relaxed text-sand-100" dir="ltr">RESTORE DATABASE [@Model.DatabaseName]
FROM DISK = N'...\backups\kirkuk-institute-….bak'
WITH REPLACE;</pre>
            <div class="mt-4 flex items-start gap-2 rounded-xl bg-amber-50 p-3 text-[11px] text-amber-900">
                <svg class="mt-0.5 h-4 w-4 shrink-0"><use href="#i-alert"/></svg>
                <span>@L.T("Restoring replaces all data recorded after the snapshot. Take a fresh snapshot before any restore.", "الاستعادة تستبدل كل البيانات المسجلة بعد النسخة. أنشئ نسخة جديدة قبل أي استعادة.")</span>
            </div>
        </div>

        <div class="card card-pad !bg-brand-50">
            <p class="flex items-start gap-2 text-xs text-brand-800">
                <svg class="mt-0.5 h-4 w-4 shrink-0"><use href="#i-shield"/></svg>
                <span>@L.T("Snapshots and exports contain personal and financial data. Store them on access-controlled media and record their distribution.", "تحتوي النسخ والتصديرات على بيانات شخصية ومالية. احفظها على وسائط محدودة الوصول وسجّل توزيعها.")</span>
            </p>
        </div>
    </div>
</div>

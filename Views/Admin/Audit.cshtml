@model AuditIndexViewModel
@{
    ViewData["Title"] = L.T("Audit trail", "سجل التدقيق");
    var fromValue = Model.From?.ToString("yyyy-MM-dd");
    var toValue = Model.To?.ToString("yyyy-MM-dd");
}
<div class="page-head">
    <div>
        <h1 class="page-title">@L.T("Audit trail", "سجل التدقيق")</h1>
        <p class="page-sub">@L.Num(Model.Total) @L.T("events", "حدثاً") · @L.Num(Model.Today) @L.T("today", "اليوم") · @L.Num(Model.Users) @L.T("actors", "مستخدم منفّذ")</p>
    </div>
    <a asp-action="ExportAudit" asp-route-q="@Model.Q" asp-route-action="@Model.Action" asp-route-entity="@Model.Entity"
       asp-route-from="@fromValue" asp-route-to="@toValue" class="btn btn-outline btn-sm">
        <svg class="h-4 w-4"><use href="#i-download"/></svg>@L.T("Export CSV", "تصدير CSV")
    </a>
</div>

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Matching events", "الأحداث المطابقة")</p><p class="kpi mt-1">@L.Num(Model.Total)</p></div>
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Recorded today", "المسجلة اليوم")</p><p class="kpi mt-1 text-brand-800">@L.Num(Model.Today)</p></div>
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Distinct actors", "المستخدمون المنفذون")</p><p class="kpi mt-1 text-emerald-700">@L.Num(Model.Users)</p></div>
    <div class="stat-card !p-4"><p class="text-xs text-ink-500">@L.T("Entity types", "أنواع السجلات")</p><p class="kpi mt-1 text-blue-700">@L.Num(Model.Entities.Count)</p></div>
</div>

<form method="get" class="card card-pad !py-4 mt-5">
    <div class="flex flex-wrap gap-2">
        <div class="relative min-w-56 flex-1">
            <span class="pointer-events-none absolute inset-y-0 start-3 flex items-center text-ink-500"><svg class="h-4 w-4"><use href="#i-search"/></svg></span>
            <input name="q" value="@Model.Q" class="input !ps-9" placeholder="@L.T("User, action, entity or value…", "المستخدم أو الإجراء أو السجل أو القيمة…")" />
        </div>
        <select name="action" class="select !w-auto max-w-56">
            <option value="">@L.T("All actions", "كل الإجراءات")</option>
            @foreach (var a in Model.Actions)
            {
                <option value="@a" selected="@(Model.Action == a)">@a</option>
            }
        </select>
        <select name="entity" class="select !w-auto max-w-48">
            <option value="">@L.T("All records", "كل السجلات")</option>
            @foreach (var e in Model.Entities)
            {
                <option value="@e" selected="@(Model.Entity == e)">@e</option>
            }
        </select>
        <input name="from" value="@fromValue" type="date" class="input !w-auto" aria-label="@L.T("From", "من")" />
        <input name="to" value="@toValue" type="date" class="input !w-auto" aria-label="@L.T("To", "إلى")" />
        <button class="btn btn-primary">@L.T("Filter", "تصفية")</button>
        <a asp-action="Audit" class="btn btn-ghost">@L.T("Reset", "إعادة تعيين")</a>
    </div>
</form>

<div class="card mt-4 overflow-hidden">
    <div class="table-wrap">
        <table class="table-base min-w-[1000px]">
            <thead>
                <tr>
                    <th>@L.T("Time", "الوقت")</th>
                    <th>@L.T("User", "المستخدم")</th>
                    <th>@L.T("Action", "الإجراء")</th>
                    <th>@L.T("Record", "السجل")</th>
                    <th>@L.T("IP address", "عنوان IP")</th>
                    <th>@L.T("Details", "التفاصيل")</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Entries.Count == 0)
            {
                <tr><td colspan="6"><div class="empty">@L.T("No audit events match these filters.", "لا توجد أحداث تدقيق مطابقة لهذه المرشحات.")</div></td></tr>
            }
            @foreach (var a in Model.Entries)
            {
                <tr>
                    <td class="whitespace-nowrap text-xs text-ink-600">
                        <span class="block font-semibold text-ink-800">@L.DateTimeShort(a.CreatedAt.ToLocalTime())</span>
                        <span class="text-[10px] text-ink-400">@L.T("local time", "التوقيت المحلي")</span>
                    </td>
                    <td class="text-xs">
                        <span class="font-semibold text-ink-800">@a.UserName</span>
                    </td>
                    <td class="text-xs text-ink-700">@a.Action</td>
                    <td class="text-xs text-ink-600">
                        <span class="font-semibold">@a.EntityName</span>
                        @if (!string.IsNullOrWhiteSpace(a.EntityId))
                        {
                            <span class="block text-[10px] text-ink-400" dir="ltr">#@a.EntityId</span>
                        }
                    </td>
                    <td class="text-[11px] text-ink-500" dir="ltr">@a.IpAddress</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(a.NewValues) || !string.IsNullOrWhiteSpace(a.OldValues))
                        {
                            <details class="group">
                                <summary class="cursor-pointer text-xs font-semibold text-brand-700 hover:text-brand-900">@L.T("Inspect", "عرض")</summary>
                                <div class="mt-2 space-y-2">
                                    @if (!string.IsNullOrWhiteSpace(a.NewValues))
                                    {
                                        <div>
                                            <p class="text-[10px] font-bold uppercase text-emerald-700">@L.T("New values", "القيم الجديدة")</p>
                                            <pre class="mt-1 max-h-40 max-w-md overflow-auto whitespace-pre-wrap break-all rounded-lg bg-sand-50 p-2 text-[10px] leading-relaxed text-ink-600">@a.NewValues</pre>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.OldValues))
                                    {
                                        <div>
                                            <p class="text-[10px] font-bold uppercase text-red-600">@L.T("Previous values", "القيم السابقة")</p>
                                            <pre class="mt-1 max-h-40 max-w-md overflow-auto whitespace-pre-wrap break-all rounded-lg bg-sand-50 p-2 text-[10px] leading-relaxed text-ink-600">@a.OldValues</pre>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                        else
                        {
                            <span class="text-[11px] text-ink-400">—</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Pages > 1)
    {
        <div class="flex items-center justify-between border-t border-sand-200 px-5 py-3 text-xs text-ink-500">
            <span>@L.T("Page", "صفحة") @Model.Page / @Model.Pages</span>
            <div class="flex gap-1">
                <a asp-action="Audit" asp-route-q="@Model.Q" asp-route-action="@Model.Action" asp-route-entity="@Model.Entity"
                   asp-route-from="@fromValue" asp-route-to="@toValue" asp-route-page="@(Model.Page - 1)"
                   class="btn btn-outline btn-xs @(Model.Page <= 1 ? "pointer-events-none opacity-40" : "")">@L.T("Previous", "السابق")</a>
                <a asp-action="Audit" asp-route-q="@Model.Q" asp-route-action="@Model.Action" asp-route-entity="@Model.Entity"
                   asp-route-from="@fromValue" asp-route-to="@toValue" asp-route-page="@(Model.Page + 1)"
                   class="btn btn-outline btn-xs @(Model.Page >= Model.Pages ? "pointer-events-none opacity-40" : "")">@L.T("Next", "التالي")</a>
            </div>
        </div>
    }
</div>
<p class="mt-3 text-[11px] text-ink-500">@L.T("The audit trail is append-only. Records are retained for compliance reviews and cannot be edited from the interface.", "سجل التدقيق إضافي فقط، وتُحفظ السجلات لمراجعات الامتثال ولا يمكن تعديلها من الواجهة.")</p>

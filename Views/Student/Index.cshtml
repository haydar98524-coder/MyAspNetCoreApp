@model StudentPortalViewModel
@{
    ViewData["Title"] = L.T("My profile", "ملفي");
    var s = Model.Student;
    var name = L.Pick(s.FullNameAr, s.FullNameEn);
    var nextSessions = Model.Schedule.Take(6).ToList();
}
<div class="page-head">
    <div>
        <p class="text-xs font-bold uppercase tracking-wider text-brand-600">@L.T("Student portal", "بوابة الطالب")</p>
        <h1 class="page-title mt-1">@L.T("Hello", "مرحباً") @name</h1>
        <p class="page-sub">@s.StudentNo · @L.Pick(s.Grade.NameAr, s.Grade.NameEn) · @L.Date(DateTime.Today)</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a asp-action="Schedule" class="btn btn-primary btn-sm"><svg class="h-4 w-4"><use href="#i-calendar"/></svg>@L.T("My schedule", "جدولي")</a>
        <a asp-controller="PrivateLessons" asp-action="Request" class="btn btn-gold btn-sm"><svg class="h-4 w-4"><use href="#i-book"/></svg>@L.T("Request a lesson", "طلب درس خصوصي")</a>
    </div>
</div>

<div class="mb-5 inline-flex flex-wrap items-center gap-1 rounded-xl border border-sand-200 bg-sand-50 p-1">
    <a asp-action="Index" class="tab active">@L.T("My profile", "ملفي")</a>
    <a asp-action="Schedule" class="tab">@L.T("Schedule", "الجدول")</a>
    <a asp-action="Attendance" class="tab">@L.T("Attendance", "الحضور")</a>
    <a asp-action="Results" class="tab">@L.T("Results", "النتائج")</a>
    <a asp-action="Payments" class="tab">@L.T("Fees", "الأقساط")</a>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="stat-card">
        <div class="flex items-start justify-between">
            <div>
                <p class="text-xs font-semibold text-ink-500">@L.T("My courses", "دوراتي")</p>
                <p class="kpi mt-2">@L.Num(Model.Enrollments.Count)</p>
                <p class="mt-1 text-[11px] text-ink-500">@L.T("Active enrollments", "اشتراكات نشطة")</p>
            </div>
            <span class="stat-icon bg-brand-50 text-brand-700"><svg class="h-5 w-5"><use href="#i-book"/></svg></span>
        </div>
        <div class="mt-4"><a asp-action="Schedule" class="text-[11px] font-bold text-brand-700 hover:underline">@L.T("Weekly schedule", "الجدول الأسبوعي")</a></div>
    </div>
    <div class="stat-card">
        <div class="flex items-start justify-between">
            <div>
                <p class="text-xs font-semibold text-ink-500">@L.T("Attendance", "الحضور")</p>
                <p class="kpi mt-2 @(Model.AttendanceRate >= 80 ? "text-emerald-700" : "text-amber-700")">@L.Percent(Model.AttendanceRate)</p>
                <p class="mt-1 text-[11px] text-ink-500">@L.Num(Model.Present) / @L.Num(Model.Sessions) @L.T("sessions", "حصة")</p>
            </div>
            <span class="stat-icon bg-emerald-50 text-emerald-700"><svg class="h-5 w-5"><use href="#i-check"/></svg></span>
        </div>
        <div class="progress mt-4"><span style="width:@Math.Min(100, Model.AttendanceRate)%"></span></div>
    </div>
    <div class="stat-card">
        <div class="flex items-start justify-between">
            <div>
                <p class="text-xs font-semibold text-ink-500">@L.T("Average mark", "المعدل")</p>
                <p class="kpi mt-2 text-brand-800">@Model.AverageMark.ToString("0.0")%</p>
                <p class="mt-1 text-[11px] text-ink-500">@L.T("Across recorded exams", "على الامتحانات المسجلة")</p>
            </div>
            <span class="stat-icon bg-blue-50 text-blue-700"><svg class="h-5 w-5"><use href="#i-chart"/></svg></span>
        </div>
        <div class="mt-4"><a asp-action="Results" class="text-[11px] font-bold text-brand-700 hover:underline">@L.T("My results", "نتائجي")</a></div>
    </div>
    <div class="stat-card">
        <div class="flex items-start justify-between">
            <div>
                <p class="text-xs font-semibold text-ink-500">@L.T("Outstanding fees", "الأقساط المتبقية")</p>
                <p class="kpi mt-2 @(Model.Outstanding > 0 ? "text-amber-700" : "text-emerald-700")">@L.Money(Model.Outstanding)</p>
                <p class="mt-1 text-[11px] text-ink-500">@L.T("Ask your guardian to review", "يرجى إبلاغ ولي الأمر")</p>
            </div>
            <span class="stat-icon bg-amber-50 text-amber-700"><svg class="h-5 w-5"><use href="#i-wallet"/></svg></span>
        </div>
        <div class="mt-4"><a asp-action="Payments" class="text-[11px] font-bold text-brand-700 hover:underline">@L.T("Fee statement", "كشف الأقساط")</a></div>
    </div>
</div>

<div class="mt-5 grid gap-5 xl:grid-cols-3">
    <div class="space-y-5 xl:col-span-2">
        <div class="card">
            <div class="card-header">
                <div>
                    <p class="section-title">@L.T("Next sessions", "الحصص القادمة")</p>
                    <p class="mt-0.5 text-xs text-ink-500">@L.T("Based on my weekly timetable", "حسب جدولي الأسبوعي")</p>
                </div>
                <a asp-action="Schedule" class="btn btn-ghost btn-xs">@L.T("Full week", "الأسبوع كامل")</a>
            </div>
            @if (nextSessions.Count == 0)
            {
                <div class="empty">@L.T("No sessions are scheduled.", "لا توجد حصص مجدولة.")</div>
            }
            else
            {
                <div class="divide-y divide-sand-200">
                    @foreach (var sc in nextSessions)
                    {
                        <div class="flex flex-wrap items-center gap-3 px-5 py-3.5">
                            <div class="flex h-11 w-14 shrink-0 flex-col items-center justify-center rounded-xl bg-brand-50">
                                <span class="text-[9px] font-bold text-brand-800">@L.Day(sc.DayOfWeek)</span>
                                <span class="text-[10px] text-ink-500">@sc.StartTime</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-bold text-ink-900">@L.Pick(sc.Section.Course.Subject.NameAr, sc.Section.Course.Subject.NameEn)</p>
                                <p class="truncate text-xs text-ink-500">@(sc.Section.Course.Teacher is null ? "—" : L.Pick(sc.Section.Course.Teacher.FullNameAr, sc.Section.Course.Teacher.FullNameEn)) · @sc.Section.Name</p>
                            </div>
                            <span class="chip"><svg class="h-3.5 w-3.5"><use href="#i-pin"/></svg>@L.Pick(sc.Classroom.NameAr, sc.Classroom.NameEn)</span>
                            <span class="text-xs font-semibold text-ink-600">@sc.StartTime – @sc.EndTime</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <div>
                    <p class="section-title">@L.T("My courses", "دوراتي")</p>
                    <p class="mt-0.5 text-xs text-ink-500">@L.T("Teachers, sections and fees", "المدرسون والشُعب والرسوم")</p>
                </div>
            </div>
            @if (Model.Enrollments.Count == 0)
            {
                <div class="empty">@L.T("You are not enrolled in any course yet.", "لم تُسجل في أي دورة بعد.")</div>
            }
            else
            {
                <div class="divide-y divide-sand-200">
                    @foreach (var e in Model.Enrollments)
                    {
                        <div class="px-5 py-4">
                            <div class="flex flex-wrap items-start justify-between gap-2">
                                <div>
                                    <p class="text-sm font-bold text-ink-900">@L.Pick(e.Course.Subject.NameAr, e.Course.Subject.NameEn)</p>
                                    <p class="mt-0.5 text-xs text-ink-500">@e.Course.Code · @L.Pick(e.Course.Teacher.FullNameAr, e.Course.Teacher.FullNameEn)</p>
                                </div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="badge badge-blue">@L.E(e.Course.Type)</span>
                                    <span class="text-sm font-bold text-brand-800">@L.Money(e.NetFee)</span>
                                </div>
                            </div>
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px] text-ink-500">
                                <span class="chip !px-2 !py-0.5">@L.T("Section", "الشعبة") @(e.Section?.Name ?? "—")</span>
                                @if (e.Section is not null)
                                {
                                    @foreach (var sc in e.Section.Schedules.OrderBy(x => ((int)x.DayOfWeek + 6) % 7).ThenBy(x => x.StartTime))
                                    {
                                        <span class="chip !px-2 !py-0.5">@L.Day(sc.DayOfWeek) @sc.StartTime · @L.Pick(sc.Classroom.NameAr, sc.Classroom.NameEn)</span>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <div>
                    <p class="section-title">@L.T("Recent results", "أحدث النتائج")</p>
                    <p class="mt-0.5 text-xs text-ink-500">@L.T("Latest recorded exams", "أحدث الامتحانات المسجلة")</p>
                </div>
                <a asp-action="Results" class="btn btn-ghost btn-xs">@L.T("All results", "جميع النتائج")</a>
            </div>
            @if (Model.Results.Count == 0)
            {
                <div class="empty">@L.T("No results have been recorded yet.", "لم تُسجل نتائج بعد.")</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table-base">
                        <thead>
                            <tr>
                                <th>@L.T("Exam", "الامتحان")</th>
                                <th>@L.T("Course", "الدورة")</th>
                                <th>@L.T("Type", "النوع")</th>
                                <th class="text-end">@L.T("Mark", "الدرجة")</th>
                                <th>@L.T("Result", "النتيجة")</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var r in Model.Results)
                        {
                            var passed = r.Mark >= r.Exam.PassMark;
                            <tr>
                                <td class="text-sm">@L.Pick(r.Exam.NameAr, r.Exam.NameEn)</td>
                                <td class="text-xs">@L.Pick(r.Exam.Course.Subject.NameAr, r.Exam.Course.Subject.NameEn)</td>
                                <td><span class="badge badge-gray">@L.E(r.Exam.Type)</span></td>
                                <td class="text-end text-sm font-bold">@r.Mark.ToString("0.#") <span class="text-[11px] font-normal text-ink-400">/ @r.Exam.MaxMark</span></td>
                                <td>
                                    @if (passed)
                                    {
                                        <span class="badge badge-green">@L.T("Pass", "ناجح")</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-red">@L.T("Fail", "راسب")</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="space-y-5">
        <div class="card card-pad">
            <div class="flex items-center gap-3">
                <span class="avatar h-12 w-12 bg-brand-100 text-brand-800">@L.Initials(name)</span>
                <div class="min-w-0">
                    <p class="truncate text-sm font-bold text-brand-950">@name</p>
                    <p class="text-xs text-ink-500">@s.StudentNo · @L.Age(s.BirthDate)</p>
                </div>
            </div>
            <dl class="mt-4 space-y-2 text-xs">
                <div class="flex justify-between"><dt class="text-ink-500">@L.T("Grade", "الصف")</dt><dd class="font-semibold text-ink-800">@L.Pick(s.Grade.NameAr, s.Grade.NameEn)</dd></div>
                <div class="flex justify-between"><dt class="text-ink-500">@L.T("School", "المدرسة")</dt><dd class="font-semibold text-ink-800">@(string.IsNullOrWhiteSpace(s.SchoolName) ? "—" : s.SchoolName)</dd></div>
                <div class="flex justify-between"><dt class="text-ink-500">@L.T("Area", "المنطقة")</dt><dd class="font-semibold text-ink-800">@(string.IsNullOrWhiteSpace(s.Area) ? "—" : s.Area)</dd></div>
                <div class="flex justify-between"><dt class="text-ink-500">@L.T("Guardian", "ولي الأمر")</dt><dd class="font-semibold text-ink-800">@(s.Parent is null ? "—" : L.Pick(s.Parent.FullNameAr, s.Parent.FullNameEn))</dd></div>
            </dl>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline btn-sm mt-4 w-full">@L.T("Account settings", "إعدادات الحساب")</a>
        </div>

        <div class="card">
            <div class="card-header">
                <div>
                    <p class="section-title">@L.T("Private lessons", "الدروس الخصوصية")</p>
                    <p class="mt-0.5 text-xs text-ink-500">@L.T("Upcoming lessons", "الدروس القادمة")</p>
                </div>
            </div>
            @if (Model.PrivateLessons.Count == 0)
            {
                <div class="empty">@L.T("No upcoming private lessons.", "لا توجد دروس خصوصية قادمة.")</div>
            }
            else
            {
                <div class="divide-y divide-sand-200">
                    @foreach (var l in Model.PrivateLessons)
                    {
                        <div class="flex items-center gap-3 px-5 py-3">
                            <div class="w-14 shrink-0 rounded-lg bg-violet-50 px-2 py-1.5 text-center">
                                <p class="text-[10px] font-bold text-violet-800">@l.Date.ToString("MM/dd")</p>
                                <p class="text-[10px] text-ink-500">@l.StartTime</p>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-semibold text-ink-900">@L.Pick(l.Subject.NameAr, l.Subject.NameEn)</p>
                                <p class="truncate text-[11px] text-ink-500">@L.Pick(l.Teacher.FullNameAr, l.Teacher.FullNameEn) · @L.E(l.Mode)</p>
                            </div>
                            <span class="text-xs font-bold text-brand-800">@L.Money(l.Fee)</span>
                        </div>
                    }
                </div>
            }
            <div class="border-t border-sand-200 px-5 py-3">
                <a asp-controller="PrivateLessons" asp-action="Request" class="btn btn-soft btn-sm w-full">@L.T("Request a private lesson", "طلب درس خصوصي")</a>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div>
                    <p class="section-title">@L.T("Fees", "الأقساط")</p>
                    <p class="mt-0.5 text-xs text-ink-500">@L.T("Open items", "البنود المفتوحة")</p>
                </div>
                <a asp-action="Payments" class="btn btn-ghost btn-xs">@L.T("Statement", "الكشف")</a>
            </div>
            @if (Model.Dues.Count == 0)
            {
                <div class="empty">@L.T("No outstanding dues.", "لا توجد أقساط مستحقة.")</div>
            }
            else
            {
                <div class="divide-y divide-sand-200">
                    @foreach (var d in Model.Dues)
                    {
                        <div class="flex items-center justify-between gap-2 px-5 py-3">
                            <div class="min-w-0">
                                <p class="truncate text-xs font-semibold text-ink-800">@d.Description</p>
                                <p class="text-[10px] text-ink-500">@L.Date(d.DueDate)</p>
                            </div>
                            <div class="text-end">
                                <p class="text-xs font-bold text-amber-700">@L.Money(d.Remaining)</p>
                                <span class="badge !px-2 !py-0.5 badge-amber">@L.E(d.Status)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

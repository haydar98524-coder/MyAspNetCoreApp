@model ParentResultsViewModel
@{
    ViewData["Title"] = L.T("Results", "النتائج");
}
<div class="page-head">
    <div>
        <div class="flex items-center gap-2 text-xs text-ink-500">
            <a asp-action="Index" class="link">@L.T("Guardian overview", "نظرة عامة")</a>
            <svg class="h-3.5 w-3.5"><use href="#i-chevron-down"/></svg>
            <span>@L.T("Results", "النتائج")</span>
        </div>
        <h1 class="page-title mt-1">@L.T("Exam results", "نتائج الامتحانات")</h1>
        <p class="page-sub">@L.T("Marks for all my children", "درجات جميع أبنائي") · @L.Num(Model.Total) @L.T("results", "نتيجة")</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a asp-action="Attendance" class="btn btn-outline btn-sm"><svg class="h-4 w-4"><use href="#i-clipboard"/></svg>@L.T("Attendance", "الحضور")</a>
        <a asp-action="Payments" class="btn btn-soft btn-sm"><svg class="h-4 w-4"><use href="#i-receipt"/></svg>@L.T("Fees", "الأقساط")</a>
    </div>
</div>

<div class="mb-5 inline-flex flex-wrap items-center gap-1 rounded-xl border border-sand-200 bg-sand-50 p-1">
    <a asp-action="Index" class="tab">@L.T("Overview", "نظرة عامة")</a>
    <a asp-action="Children" class="tab">@L.T("My children", "أبنائي")</a>
    <a asp-action="Payments" class="tab">@L.T("Fees", "الأقساط")</a>
    <a asp-action="Attendance" class="tab">@L.T("Attendance", "الحضور")</a>
    <a asp-action="Results" class="tab active">@L.T("Results", "النتائج")</a>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="stat-card">
        <p class="text-xs font-semibold text-ink-500">@L.T("Results", "النتائج")</p>
        <p class="kpi mt-2">@L.Num(Model.Total)</p>
        <p class="mt-1 text-[11px] text-ink-500">@L.T("Matching the current filter", "حسب التصفية الحالية")</p>
    </div>
    <div class="stat-card">
        <p class="text-xs font-semibold text-ink-500">@L.T("Average", "المعدل")</p>
        <p class="kpi mt-2 @(Model.Average >= 50 ? "text-emerald-700" : "text-red-600")">@Model.Average.ToString("0.0")%</p>
        <div class="progress mt-3"><span style="width:@Math.Min(100, Model.Average)%"></span></div>
    </div>
    <div class="stat-card">
        <p class="text-xs font-semibold text-ink-500">@L.T("Passed", "ناجح")</p>
        <p class="kpi mt-2 text-emerald-700">@L.Num(Model.Passed)</p>
        <p class="mt-1 text-[11px] text-ink-500">@L.T("At or above the pass mark", "عند أو فوق درجة النجاح")</p>
    </div>
    <div class="stat-card">
        <p class="text-xs font-semibold text-ink-500">@L.T("Below pass mark", "دون درجة النجاح")</p>
        <p class="kpi mt-2 @(Model.Failed > 0 ? "text-red-600" : "")">@L.Num(Model.Failed)</p>
        <p class="mt-1 text-[11px] text-ink-500">@L.T("Needs follow-up", "بحاجة إلى متابعة")</p>
    </div>
</div>

<div class="card mt-5">
    <div class="card-header">
        <div>
            <p class="section-title">@L.T("Result sheet", "كشف النتائج")</p>
            <p class="mt-0.5 text-xs text-ink-500">@L.T("Latest exams first", "الأحدث أولاً")</p>
        </div>
        <form asp-action="Results" method="get" class="flex flex-wrap items-end gap-2">
            <select name="studentId" class="select !w-auto !py-2 !text-xs">
                <option value="">@L.T("All children", "جميع الأبناء")</option>
                @foreach (var c in Model.Children)
                {
                    <option value="@c.Id" selected="@(Model.StudentId == c.Id)">@L.Pick(c.FullNameAr, c.FullNameEn)</option>
                }
            </select>
            <select name="type" class="select !w-auto !py-2 !text-xs">
                <option value="">@L.T("All exam types", "جميع أنواع الامتحانات")</option>
                @foreach (var t in Enum.GetValues<ExamType>())
                {
                    <option value="@t" selected="@(Model.Type == t)">@L.E(t)</option>
                }
            </select>
            <button class="btn btn-outline btn-sm"><svg class="h-4 w-4"><use href="#i-filter"/></svg>@L.T("Filter", "تصفية")</button>
            <a asp-action="Results" class="btn btn-ghost btn-sm">@L.T("Reset", "إعادة ضبط")</a>
        </form>
    </div>
    @if (Model.Results.Count == 0)
    {
        <div class="empty">@L.T("No results match the filter.", "لا توجد نتائج مطابقة للتصفية.")</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table-base">
                <thead>
                    <tr>
                        <th>@L.T("Date", "التاريخ")</th>
                        <th>@L.T("Student", "الطالب")</th>
                        <th>@L.T("Exam", "الامتحان")</th>
                        <th>@L.T("Course", "الدورة")</th>
                        <th>@L.T("Type", "النوع")</th>
                        <th class="text-end">@L.T("Mark", "الدرجة")</th>
                        <th class="w-40">@L.T("Percentage", "النسبة")</th>
                        <th>@L.T("Result", "النتيجة")</th>
                        <th>@L.T("Notes", "ملاحظات")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Results)
                {
                    var pct = r.Exam.MaxMark == 0 ? 0 : Math.Round(r.Mark * 100m / r.Exam.MaxMark, 1);
                    var passed = r.Mark >= r.Exam.PassMark;
                    <tr>
                        <td class="text-xs">@L.DateShort(r.Exam.Date)</td>
                        <td class="text-xs font-semibold">@L.Pick(r.Student.FullNameAr, r.Student.FullNameEn)</td>
                        <td class="text-sm">@L.Pick(r.Exam.NameAr, r.Exam.NameEn)</td>
                        <td class="text-xs">@L.Pick(r.Exam.Course.Subject.NameAr, r.Exam.Course.Subject.NameEn)</td>
                        <td><span class="badge badge-gray">@L.E(r.Exam.Type)</span></td>
                        <td class="text-end text-sm font-bold">@r.Mark.ToString("0.#") <span class="text-[11px] font-normal text-ink-400">/ @r.Exam.MaxMark</span></td>
                        <td>
                            <div class="flex items-center gap-2">
                                <div class="progress flex-1"><span style="width:@Math.Min(100, pct)%"></span></div>
                                <span class="w-12 text-end text-[11px] font-bold text-ink-700">@pct.ToString("0.0")%</span>
                            </div>
                        </td>
                        <td>
                            @if (passed)
                            {
                                <span class="badge badge-green">@L.T("Pass", "ناجح")</span>
                            }
                            else
                            {
                                <span class="badge badge-red">@L.T("Fail", "راسب")</span>
                            }
                        </td>
                        <td class="max-w-48 text-[11px] text-ink-500">@(r.Notes ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<p class="mt-4 flex items-center gap-2 text-[11px] text-ink-500">
    <svg class="h-4 w-4 text-brand-600"><use href="#i-info"/></svg>
    @L.T("Marks are entered by teachers and reviewed by the academic department. Contact the registrar for any inquiry.",
        "تُدخل الدرجات من المدرسين وتُراجع من القسم الأكاديمي. تواصل مع التسجيل لأي استفسار.")
</p>

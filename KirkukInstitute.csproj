<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep local working folders out of compilation, content, publish output and file watching:
         .preview  = preview browser profile (locked files while the browser is open)
         App_Data  = uploads and database backups (runtime data, never shipped)
         tools     = Tailwind CLI binary used only at design time
         vibe_images = design reference screenshots -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.preview/**;App_Data/**;tools/**;vibe_images/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- AI assistant: the reader-principal SQL script and the system prompt are compiled into the
       assembly so they cannot be altered on disk at runtime. -->
  <ItemGroup>
    <None Remove="Ai\Sql\*.sql;Ai\Prompts\*.md" />
    <EmbeddedResource Include="Ai\Sql\*.sql;Ai\Prompts\*.md" />
  </ItemGroup>

</Project>
